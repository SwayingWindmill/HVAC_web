name: S3 Command Safety

on:
  pull_request:
    branches-ignore: ["**"]
    paths:
      - '.github/workflows/s3-command-safety.yml'
      - 'scripts/check-s3-workflow-topology.mjs'
      - 'contracts/http/s3-command-public.openapi.json'
      - 'contracts/ownership/**'
      - 'deploy/s3/**'
      - 'docs/adr/0006-s3-command-intent-attempt-safety.md'
      - 'docs/operations/s3-implementation-plan.md'
      - 'libs/commandmodel/**'
      - 'services/command-service/**'
      - 'services/command-dispatcher/**'
      - 'services/thingsboard-connector-control/**'
      - 'scripts/check-s3-command-baseline.mjs'
      - 'scripts/check-ownership-registries.mjs'
      - 'go.work'
      - 'go.work.sum'
  push:
    branches: [main]
    paths:
      - '.github/workflows/s3-command-safety.yml'
      - 'scripts/check-s3-workflow-topology.mjs'
      - 'contracts/http/s3-command-public.openapi.json'
      - 'contracts/ownership/**'
      - 'deploy/s3/**'
      - 'docs/adr/0006-s3-command-intent-attempt-safety.md'
      - 'docs/operations/s3-implementation-plan.md'
      - 'libs/commandmodel/**'
      - 'services/command-service/**'
      - 'services/command-dispatcher/**'
      - 'services/thingsboard-connector-control/**'
      - 'scripts/check-s3-command-baseline.mjs'
      - 'scripts/check-ownership-registries.mjs'
      - 'go.work'
      - 'go.work.sum'

permissions:
  contents: read

concurrency:
  group: s3-command-safety-${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

jobs:
  command-safety-baseline:
    runs-on: ubuntu-24.04
    timeout-minutes: 20
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-go@v5
        with:
          go-version: '1.25.12'
          cache: false
      - uses: actions/setup-node@v4
        with:
          node-version: '22.22.0'
          cache: npm
      - run: npm ci
      - run: npm run s3:topology:check
      - run: npm run s3:command-safety
      - run: npm run lint
      - run: npm run build
