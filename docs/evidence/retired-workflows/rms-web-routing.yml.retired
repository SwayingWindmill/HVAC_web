name: RMS Web Routing

on:
  pull_request:
    branches-ignore: ["**"]
    paths:
      - '.github/workflows/rms-web-routing.yml'
      - 'scripts/check-rms-workflow-topology.mjs'
      - 'apps/hvac-web/src/real/**'
      - 'apps/hvac-web/src/api/generated/platformGateway.gen.ts'
      - 'apps/hvac-web/vite.real.config.ts'
      - 'apps/hvac-web/vite.shared.config.ts'
      - 'contracts/http/**'
      - 'scripts/check-rms-real-build-graph.mjs'
      - 'scripts/check-rms-real-bundle.mjs'
      - 'scripts/rms-real-build-audit-lib.mjs'
      - 'scripts/test-rms-authenticated-shell-policy.mjs'
      - 'scripts/test-rms-feature-route-policy.mjs'
      - 'scripts/test-rms-site-routing.mjs'
      - 'scripts/test-rms-protected-scope.mjs'
      - 'scripts/test-rms-realtime-status.mjs'
      - 'scripts/test-rms-shell-runtime.mjs'
  push:
    branches: [main]
    paths:
      - '.github/workflows/rms-web-routing.yml'
      - 'scripts/check-rms-workflow-topology.mjs'
      - 'apps/hvac-web/src/real/**'
      - 'apps/hvac-web/src/api/generated/platformGateway.gen.ts'
      - 'apps/hvac-web/vite.real.config.ts'
      - 'apps/hvac-web/vite.shared.config.ts'
      - 'contracts/http/**'
      - 'scripts/check-rms-real-build-graph.mjs'
      - 'scripts/check-rms-real-bundle.mjs'
      - 'scripts/rms-real-build-audit-lib.mjs'
      - 'scripts/test-rms-authenticated-shell-policy.mjs'
      - 'scripts/test-rms-feature-route-policy.mjs'
      - 'scripts/test-rms-site-routing.mjs'
      - 'scripts/test-rms-protected-scope.mjs'
      - 'scripts/test-rms-realtime-status.mjs'
      - 'scripts/test-rms-shell-runtime.mjs'

permissions:
  contents: read

env:
  NODE_OPTIONS: --max-old-space-size=4096

jobs:
  verify:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: '22.22.0'
          cache: npm
      - run: npm ci
      - run: npm run rms:topology:check
      - run: npm run rms:web-routing
