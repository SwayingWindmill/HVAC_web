name: S4 Alarm Authorized Read Canary and Promotion Gate

on:
  pull_request:
    branches-ignore: ["**"]
    paths:
      - '.github/workflows/s4-alarm-baseline.yml'
      - 'apps/hvac-web/src/api/alarm-contract.ts'
      - 'apps/hvac-web/src/api/alarms.ts'
      - 'apps/hvac-web/src/api/generated/platformGateway.gen.ts'
      - 'apps/hvac-web/src/real/LocalAlarmLifecycle.tsx'
      - 'apps/hvac-web/src/real/RealAlarms.tsx'
      - 'apps/hvac-web/src/real/RealApp.tsx'
      - 'apps/hvac-web/src/real/real-alarms-projection.ts'
      - 'apps/hvac-web/src/real/real-alarms.css'
      - 'apps/hvac-web/src/real/SiteScopedShell.tsx'
      - 'apps/hvac-web/src/real/site-routing.ts'
      - 'contracts/http/platform-gateway.openapi.yaml'
      - 'contracts/http/s4-alarm-public.openapi.json'
      - 'contracts/http/templates/platformGateway.ts.tmpl'
      - 'contracts/http/templates/platformapi.go.tmpl'
      - 'contracts/ownership/**'
      - 'docs/operations/real-product-roadmap.md'
      - 'docs/operations/s4-alarm-read-promotion.md'
      - 'deploy/s4/**'
      - 'go.work'
      - 'go.work.sum'
      - 'infra/s1-registry/postgres/init/007-s4-alarm-authorization.sql'
      - 'infra/s4-alarm/**'
      - 'libs/alarmauth/**'
      - 'libs/alarmmodel/**'
      - 'libs/identitycontext/**'
      - 'libs/ownershipregistry/**'
      - 'scripts/check-ownership-registries.mjs'
      - 'scripts/check-s0-release-evidence-assets.mjs'
      - 'scripts/check-s4-alarm-baseline.mjs'
      - 'scripts/fixtures/real-alarms/**'
      - 'scripts/fixtures/s4-alarm-read-promotion/**'
      - 'scripts/generate-platform-contracts.mjs'
      - 'scripts/run-real-alarm-lifecycle-browser-audit.mjs'
      - 'scripts/run-real-alarms-browser-audit.mjs'
      - 'scripts/run-s4-alarm-postgres-tests.ts'
      - 'scripts/lib/postgres-compose-harness.ts'
      - 'scripts/run-s4-alarm-read-promotion-certification.mjs'
      - 'scripts/test-real-alarms.mjs'
      - 'scripts/test-s4-alarm-read-promotion-certification.mjs'
      - 'scripts/verify-s4-alarm-read-promotion-certification.mjs'
      - 'services/alarm-service/**'
      - 'services/iam-service/**'
      - 'services/platform-gateway/**'
  push:
    branches: [main]
    paths:
      - '.github/workflows/s4-alarm-baseline.yml'
      - 'apps/hvac-web/src/api/alarm-contract.ts'
      - 'apps/hvac-web/src/api/alarms.ts'
      - 'apps/hvac-web/src/api/generated/platformGateway.gen.ts'
      - 'apps/hvac-web/src/real/LocalAlarmLifecycle.tsx'
      - 'apps/hvac-web/src/real/RealAlarms.tsx'
      - 'apps/hvac-web/src/real/RealApp.tsx'
      - 'apps/hvac-web/src/real/real-alarms-projection.ts'
      - 'apps/hvac-web/src/real/real-alarms.css'
      - 'apps/hvac-web/src/real/SiteScopedShell.tsx'
      - 'apps/hvac-web/src/real/site-routing.ts'
      - 'contracts/http/platform-gateway.openapi.yaml'
      - 'contracts/http/s4-alarm-public.openapi.json'
      - 'contracts/http/templates/platformGateway.ts.tmpl'
      - 'contracts/http/templates/platformapi.go.tmpl'
      - 'contracts/ownership/**'
      - 'docs/operations/real-product-roadmap.md'
      - 'docs/operations/s4-alarm-read-promotion.md'
      - 'deploy/s4/**'
      - 'go.work'
      - 'go.work.sum'
      - 'infra/s1-registry/postgres/init/007-s4-alarm-authorization.sql'
      - 'infra/s4-alarm/**'
      - 'libs/alarmauth/**'
      - 'libs/alarmmodel/**'
      - 'libs/identitycontext/**'
      - 'libs/ownershipregistry/**'
      - 'scripts/check-ownership-registries.mjs'
      - 'scripts/check-s0-release-evidence-assets.mjs'
      - 'scripts/check-s4-alarm-baseline.mjs'
      - 'scripts/fixtures/real-alarms/**'
      - 'scripts/fixtures/s4-alarm-read-promotion/**'
      - 'scripts/generate-platform-contracts.mjs'
      - 'scripts/run-real-alarm-lifecycle-browser-audit.mjs'
      - 'scripts/run-real-alarms-browser-audit.mjs'
      - 'scripts/run-s4-alarm-postgres-tests.ts'
      - 'scripts/lib/postgres-compose-harness.ts'
      - 'scripts/run-s4-alarm-read-promotion-certification.mjs'
      - 'scripts/test-real-alarms.mjs'
      - 'scripts/test-s4-alarm-read-promotion-certification.mjs'
      - 'scripts/verify-s4-alarm-read-promotion-certification.mjs'
      - 'services/alarm-service/**'
      - 'services/iam-service/**'
      - 'services/platform-gateway/**'
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: s4-alarm-baseline-${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

jobs:
  verify:
    runs-on: ubuntu-24.04
    timeout-minutes: 40
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-go@v5
        with:
          go-version: '1.25.12'
          cache: false
      - uses: actions/setup-node@v4
        with:
          node-version: '22.22.0'
          cache: npm
      - run: npm ci
      - run: npm run contracts:check
      - run: npm run s4:alarm-service
      - run: node scripts/run-go.mjs test ./libs/alarmauth/... ./libs/identitycontext/... ./services/iam-service/... ./services/platform-gateway/...
      - run: node scripts/run-go.mjs vet ./libs/alarmauth/... ./libs/identitycontext/... ./services/iam-service/... ./services/platform-gateway/...
      - run: npm run real-alarms:test
      - run: npm run lint
      - run: npm run build:iam
      - run: npm run build:gateway
      - run: npm run build:alarm-service
      - run: npm run s1:registry:postgres
      - run: npm run s4:alarm:postgres
      - run: npm run build:real
      - run: npm run rms:real:graph
      - run: npm run real-alarms:browser
      - run: npm run real-alarms:lifecycle-browser
      - name: Upload Real Alarm read, lifecycle and promotion preflight evidence
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: real-alarm-read-canary-evidence
          path: |
            out/real-alarms-certification
            out/real-alarm-lifecycle-certification
            out/s4-alarm-read-promotion-preflight
            out/s1-registry-core
            out/s4-alarm-authority
          if-no-files-found: error
          retention-days: 14
