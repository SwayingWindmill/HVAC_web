{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": ".cache/tsconfig.node.tsbuildinfo",
    "outDir": ".cache/node-build",
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "allowSyntheticDefaultImports": true,
    "strict": true
  },
  "include": ["vite.config.ts"]
}
