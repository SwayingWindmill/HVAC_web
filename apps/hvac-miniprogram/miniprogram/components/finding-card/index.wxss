.finding {
  display: flex;
  flex-direction: column;
  gap: 12px;
  padding: 14px;
  border: 1px solid var(--border);
  border-radius: 10px;
  background: var(--card);
}

.chart {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.rank {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.rank-line {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  font-size: 13px;
}

.rank-label {
  color: var(--secondary-foreground);
}

.rank-value {
  font-weight: 600;
}

.rank-track {
  height: 6px;
  border-radius: 3px;
  background: var(--secondary);
}

.rank-bar {
  height: 6px;
  border-radius: 3px;
  background: var(--primary);
}

.columns {
  display: flex;
  align-items: flex-end;
  gap: 8px;
  height: 140px;
  box-sizing: border-box;
  /* Room for the value over the tallest bar. */
  padding-top: 18px;
}

.column {
  flex: 1;
  min-width: 0;
  height: 100%;
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.column-bars {
  flex: 1;
  display: flex;
  align-items: flex-end;
  gap: 2px;
  border-bottom: 1px solid var(--border);
}

.column-bar {
  position: relative;
  flex: 1;
  min-height: 2px;
  border-radius: 3px 3px 0 0;
}

.column-value {
  position: absolute;
  top: -18px;
  left: 0;
  right: 0;
  text-align: center;
  font-size: 11px;
  line-height: 16px;
  color: var(--secondary-foreground);
}

.column-label {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  text-align: center;
  font-size: 11px;
  color: var(--muted-foreground);
}

.series-0 { background: #3f5bd9; }
.series-1 { background: #0e9384; }
.series-2 { background: #8b5cf6; }
.series-3 { background: #d6409f; }

.line-plot {
  display: grid;
  grid-template-columns: auto minmax(0, 1fr);
  gap: 6px;
}

.line-scale {
  height: 120px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  font-size: 10px;
  color: var(--muted-foreground);
  text-align: right;
}

.line-ends {
  display: flex;
  justify-content: space-between;
}

.legend {
  display: flex;
  flex-wrap: wrap;
  gap: 6px 12px;
  font-size: 12px;
  color: var(--muted-foreground);
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 5px;
}

.swatch {
  width: 10px;
  height: 10px;
  border-radius: 2px;
}

.figures {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 8px;
}

.figure {
  display: flex;
  flex-direction: column;
  gap: 2px;
  padding: 8px 10px;
  border-radius: 8px;
  background: var(--muted);
}

.figure-value {
  font-size: 16px;
  font-weight: 600;
}

.limitation {
  display: flex;
  gap: 6px;
  font-size: 12px;
  line-height: 18px;
  color: var(--muted-foreground);
}

.limitation-mark {
  flex-shrink: 0;
}
