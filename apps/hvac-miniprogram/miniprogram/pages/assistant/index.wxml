<view class="screen with-composer">
  <view wx:if="{{loading}}" class="state">正在载入对话…</view>
  <view wx:elif="{{noSite}}" class="state">这个账号还看不到任何站点，请管理员在网页「系统管理」里分配站点。</view>
  <block wx:else>
    <view class="bar">
      <text class="caption">{{siteName}} · 只读数据，不操作设备</text>
      <view class="bar-actions">
        <text class="bar-action" bindtap="openHistory" aria-role="button">历史对话</text>
        <text wx:if="{{conversation}}" class="bar-action {{conversation.running ? 'bar-action-off' : ''}}" bindtap="startNew" aria-role="button" aria-disabled="{{conversation.running}}">新对话</text>
      </view>
    </view>

    <view wx:if="{{error}}" class="error" aria-role="alert">{{error}}</view>

    <block wx:if="{{!conversation}}">
      <view class="welcome">
        <view class="welcome-mark" aria-hidden="true"><image class="welcome-icon" src="/assets/tab/assistant.svg" /></view>
        <text class="welcome-title">想问{{siteName}}什么？</text>
        <text class="welcome-text">我能读用电、能效、电费、告警和设备读数，先给结论再给数字。我不能操作设备。</text>
      </view>
      <view class="card">
        <view wx:for="{{starters}}" wx:key="prompt" class="row starter" data-prompt="{{item.prompt}}" bindtap="askThis" aria-role="button">
          <text class="badge badge-neutral">{{item.topic}}</text>
          <text class="starter-text">{{item.prompt}}</text>
        </view>
      </view>
      <block wx:if="{{recent.length}}">
        <view class="section-head">
          <text class="section-title">最近的对话</text>
          <text wx:if="{{hasMore}}" class="caption" bindtap="openHistory" aria-role="link">全部 ›</text>
        </view>
        <view class="card">
          <view wx:for="{{recent}}" wx:key="id" class="row recent" data-id="{{item.id}}" bindtap="open" aria-role="link">
            <view class="recent-main">
              <text class="recent-question">{{item.question}}</text>
              <text class="caption">{{item.detail}}</text>
            </view>
            <text class="chevron-right" aria-hidden="true">›</text>
          </view>
        </view>
      </block>
    </block>

    <block wx:else>
      <block wx:for="{{conversation.messages}}" wx:key="id">
        <view wx:if="{{item.role === 'user'}}" class="ask"><text class="ask-text" user-select>{{item.text}}</text></view>
        <view wx:else class="reply">
          <view class="speaker">
            <view class="speaker-mark" aria-hidden="true"><image class="speaker-icon" src="/assets/tab/assistant.svg" /></view>
            <text>助手</text>
          </view>
          <text wx:if="{{item.thinking}}" class="thinking">正在思考…</text>
          <view wx:if="{{item.steps}}" class="steps" data-id="{{item.id}}" bindtap="toggleSteps" aria-role="button" aria-expanded="{{item.steps.running || openSteps[item.id]}}">
            <view class="steps-line">
              <view wx:if="{{item.steps.running}}" class="dot dot-running" aria-hidden="true" />
              <text class="steps-summary">{{item.steps.summary}}</text>
              <text class="steps-toggle" aria-hidden="true">{{item.steps.running || openSteps[item.id] ? '收起' : '展开'}}</text>
            </view>
            <block wx:if="{{item.steps.running || openSteps[item.id]}}">
              <view wx:for="{{item.steps.items}}" wx:for-item="step" wx:for-index="position" wx:key="position" class="step step-{{step.state}}">
                <text class="step-mark" aria-hidden="true">{{step.state === 'done' ? '✓' : step.state === 'failed' ? '✕' : '…'}}</text>
                <text>{{step.label}}{{step.state === 'failed' ? '，没有读到数据' : ''}}</text>
              </view>
            </block>
          </view>
          <view wx:if="{{item.answer}}" class="answer">
            <block wx:for="{{item.answer}}" wx:for-item="block" wx:for-index="position" wx:key="position">
              <rich-text wx:if="{{block.kind === 'text'}}" nodes="{{block.nodes}}" user-select />
              <scroll-view wx:else class="table-scroll" scroll-x enhanced show-scrollbar="{{false}}">
                <view class="table">
                  <view class="table-row table-head">
                    <view wx:for="{{block.head}}" wx:for-item="cell" wx:for-index="column" wx:key="column" class="table-cell cell-{{cell.align}} {{cell.wraps ? 'cell-wraps' : ''}}"><rich-text nodes="{{cell.nodes}}" /></view>
                  </view>
                  <view wx:for="{{block.rows}}" wx:for-item="row" wx:for-index="line" wx:key="line" class="table-row">
                    <view wx:for="{{row}}" wx:for-item="cell" wx:for-index="column" wx:key="column" class="table-cell cell-{{cell.align}} {{cell.wraps ? 'cell-wraps' : ''}}"><rich-text nodes="{{cell.nodes}}" user-select /></view>
                  </view>
                </view>
              </scroll-view>
            </block>
          </view>
          <finding-card wx:if="{{item.finding}}" finding="{{item.finding}}" />
          <view wx:if="{{item.question}}" class="question">
            <text class="caption">需要补充信息</text>
            <text class="question-text">{{item.question.prompt}}</text>
            <view wx:if="{{item.question.choices.length}}" class="choices">
              <text
                wx:for="{{item.question.choices}}"
                wx:for-item="choice"
                wx:key="value"
                class="choice {{item.question.open ? '' : 'choice-off'}}"
                data-value="{{choice.value}}"
                data-open="{{item.question.open}}"
                bindtap="choose"
                aria-role="button"
                aria-disabled="{{!item.question.open}}"
              >{{choice.label}}</text>
            </view>
            <text wx:if="{{item.question.byText}}" class="caption">在下方输入框里回答。</text>
          </view>
          <text wx:if="{{item.note}}" class="note {{item.note.failed ? 'note-failed' : ''}}">{{item.note.text}}</text>
        </view>
      </block>

      <view wx:if="{{!conversation.running && conversation.suggestions.length}}" class="suggestions">
        <text class="caption">接着问</text>
        <text wx:for="{{conversation.suggestions}}" wx:key="*this" class="suggestion" data-prompt="{{item}}" bindtap="askThis" aria-role="button">{{item}}</text>
      </view>
    </block>
    <view id="latest" />
  </block>
</view>

<view wx:if="{{!loading && !noSite}}" class="composer">
  <input
    class="composer-input"
    value="{{draft}}"
    placeholder="{{conversation.answering ? '回答助手的问题' : '问问这个站点的用电、负荷或设备'}}"
    confirm-type="send"
    maxlength="4000"
    disabled="{{sending}}"
    bindinput="onDraft"
    bindconfirm="send"
  />
  <view wx:if="{{conversation.running}}" class="composer-button composer-stop" bindtap="stop" aria-role="button" aria-label="停止回答"><view class="stop-mark" /></view>
  <view wx:else class="composer-button {{sending || !draft ? 'composer-button-off' : ''}}" bindtap="send" aria-role="button" aria-label="发送" aria-disabled="{{sending || !draft}}">
    <image class="send-icon" src="/assets/send.svg" aria-hidden="true" />
  </view>
</view>
