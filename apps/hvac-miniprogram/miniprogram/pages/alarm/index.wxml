<view class="screen with-footer">
  <view wx:if="{{loading}}" class="state">正在读取…</view>
  <view wx:elif="{{failed}}" class="state">{{failed}}</view>
  <block wx:elif="{{view}}">
    <view class="card card-pad head">
      <view class="head-line">
        <view class="badge severity-badge sev-{{view.level}}"><image class="severity-shape" src="/assets/severity/{{view.level}}.svg" aria-hidden="true" /><text>{{view.severity}}</text></view>
        <text class="caption">{{view.state}}</text>
      </view>
      <text class="title">{{view.title}}</text>
      <text class="summary {{summaryLong && !summaryOpen ? 'summary-clamped' : ''}}">{{view.summary}}</text>
      <text wx:if="{{summaryLong}}" class="summary-toggle" bindtap="toggleSummary" aria-role="button">{{summaryOpen ? '收起' : '展开'}}</text>
    </view>

    <view class="card">
      <view wx:for="{{view.facts}}" wx:key="label" class="row fact">
        <text class="fact-label">{{item.label}}</text>
        <text class="fact-value">{{item.value}}</text>
      </view>
    </view>

    <view wx:if="{{view.acknowledgement}}" class="card card-pad acknowledged">
      <text class="badge badge-neutral">已确认</text>
      <text class="caption">{{view.acknowledgement.who}}{{view.acknowledgement.when ? ' · ' + view.acknowledgement.when : ''}}</text>
      <text wx:if="{{view.acknowledgement.comment}}" class="acknowledged-comment">{{view.acknowledgement.comment}}</text>
    </view>

    <view wx:if="{{view.canAcknowledge}}" class="card card-pad acknowledge">
      <text class="caption">确认说明（可以不填）</text>
      <textarea
        class="comment"
        value="{{comment}}"
        placeholder="比如：已通知厂家明天来查"
        maxlength="500"
        auto-height
        disable-default-padding
        bindinput="onComment"
      />
      <text class="caption">{{view.acknowledgeNote}}</text>
      <text wx:if="{{error}}" class="error" aria-role="alert">{{error}}</text>
    </view>

  </block>
</view>

<view wx:if="{{view}}" class="footer">
  <button class="button-outline action" bindtap="askAssistant">问助手</button>
  <button wx:if="{{view.canAcknowledge}}" class="button-primary action" disabled="{{acknowledging}}" bindtap="acknowledge">{{acknowledging ? '正在确认…' : '确认告警'}}</button>
</view>
