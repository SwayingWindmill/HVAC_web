.head {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.head-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}

.title {
  font-size: 19px;
  line-height: 26px;
  font-weight: 700;
}

.summary {
  font-size: 14px;
  line-height: 22px;
  color: var(--secondary-foreground);
}

/* Three lines until 展开: the alarm's own explanation can run long (#677). */
.summary-clamped {
  display: -webkit-box;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
}

.summary-toggle {
  align-self: flex-start;
  font-size: 13px;
  font-weight: 500;
  color: var(--primary);
}

.fact-label {
  font-size: 14px;
  color: var(--muted-foreground);
}

.fact-value {
  font-size: 15px;
  font-weight: 600;
}

.acknowledged {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.acknowledged-comment {
  font-size: 14px;
  line-height: 22px;
}

.acknowledge {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.comment {
  width: 100%;
  min-height: 72px;
  box-sizing: border-box;
  padding: 10px 12px;
  border: 1px solid var(--input);
  border-radius: 8px;
  background: var(--background);
  font-size: 15px;
  line-height: 22px;
}

.error {
  font-size: 13px;
  color: var(--destructive-text);
}

/* The last card stays clear of the buttons pinned under it. */
.with-footer {
  padding-bottom: calc(88px + env(safe-area-inset-bottom));
}

.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 12px;
  padding: 12px 16px calc(12px + env(safe-area-inset-bottom));
  border-top: 1px solid var(--border);
  background: var(--card);
}

button.action {
  flex: 1;
  width: auto !important;
}
