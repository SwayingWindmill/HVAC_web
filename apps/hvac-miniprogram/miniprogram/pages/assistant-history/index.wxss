.conversation {
  gap: 12px;
  padding-top: 10px;
  padding-bottom: 10px;
}

.conversation-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.conversation-question {
  display: -webkit-box;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  font-size: 15px;
  line-height: 22px;
}

.chevron-right {
  color: var(--subtle-foreground);
}
