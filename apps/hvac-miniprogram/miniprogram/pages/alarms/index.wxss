.top {
  padding-top: 12px;
}

.filter-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}

.unacknowledged {
  display: flex;
  align-items: center;
  gap: 6px;
}

.unacknowledged switch {
  transform: scale(0.75);
  transform-origin: right center;
}

.alarm {
  display: flex;
  align-items: center;
  gap: 10px;
  min-height: 60px;
  padding: 10px 12px 10px 16px;
  border-top: 1px solid var(--divider);
}

.alarm:first-child {
  border-top: 0;
}

.severity-mark {
  flex-shrink: 0;
  width: 10px;
  height: 10px;
}

.alarm-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.alarm-title {
  font-size: 15px;
  line-height: 22px;
  font-weight: 600;
}

.chevron-right {
  color: var(--subtle-foreground);
}

.legend {
  padding: 0 4px;
}
