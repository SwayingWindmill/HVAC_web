.top {
  padding-top: 12px;
}

.filter-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}

.chip {
  flex-shrink: 0;
  padding: 5px 12px;
  border: 1px solid var(--border);
  border-radius: 16px;
  background: var(--card);
  font-size: 13px;
  color: var(--secondary-foreground);
}

.chip-on {
  border-color: var(--primary-line);
  background: var(--primary-soft);
  color: #2f46b3;
  font-weight: 600;
}

.alarms {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.alarm {
  display: flex;
  align-items: center;
  gap: 10px;
  min-height: 60px;
  padding: 10px 12px 10px 16px;
}

.severity-mark {
  flex-shrink: 0;
  width: 10px;
  height: 10px;
}

.alarm-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.alarm-title {
  font-size: 15px;
  line-height: 22px;
  font-weight: 600;
}

.chevron-right {
  color: var(--subtle-foreground);
}

.legend {
  padding: 0 4px;
}
