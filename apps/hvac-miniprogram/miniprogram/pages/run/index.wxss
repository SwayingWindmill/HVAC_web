@import "../../styles/hour-chart.wxss";

.meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 24px;
}

.plant {
  display: flex;
  flex-direction: column;
  gap: 14px;
  padding: 16px;
}

.plant-status {
  display: flex;
  align-items: center;
  gap: 8px;
}

.plant-label {
  font-size: 17px;
  font-weight: 600;
}

.plant-metrics {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12px;
}

.plant-metric {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.plant-value {
  font-size: 22px;
  line-height: 28px;
  font-weight: 600;
  letter-spacing: -0.02em;
}

.plant-value-dim {
  color: var(--subtle-foreground);
}

.chart {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.chart-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.loops-title {
  padding-bottom: 10px;
}

.loop {
  display: grid;
  grid-template-columns: 56px minmax(0, 1fr);
  gap: 12px;
  padding: 12px 16px;
  border-top: 1px solid var(--divider);
}

.loop-name {
  font-size: 13px;
  color: var(--muted-foreground);
}

.loop-values {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.loop-headline {
  font-size: 15px;
  font-weight: 600;
}

.devices-link {
  border-top: 1px solid var(--border);
}

.filters {
  width: 100%;
  white-space: nowrap;
}

.filter-row {
  display: flex;
  gap: 8px;
}

.filter {
  display: flex;
  align-items: center;
  gap: 4px;
  height: 32px;
  box-sizing: border-box;
  padding: 0 12px;
  border: 1px solid var(--border);
  border-radius: 16px;
  background: var(--card);
  font-size: 13px;
  color: var(--secondary-foreground);
}

.filter-on {
  border-color: var(--primary-line);
  background: var(--primary-soft);
  color: #2f46b3;
  font-weight: 600;
}

.filter-count {
  font-family: "Geist Mono", ui-monospace, Menlo, monospace;
  color: var(--subtle-foreground);
}

.filter-on .filter-count {
  color: #2f46b3;
}

.group {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.group-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 0 4px;
}

.group-title {
  font-size: 14px;
  font-weight: 600;
}

.device {
  display: flex;
  align-items: center;
  gap: 12px;
  min-height: 60px;
  padding: 10px 12px 10px 16px;
  border-top: 1px solid var(--divider);
}

.device:first-child {
  border-top: 0;
}

.device-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.device-line {
  display: flex;
  align-items: center;
  gap: 8px;
}

.device-name {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 15px;
  font-weight: 600;
}

.device-value {
  flex-shrink: 0;
  font-size: 17px;
  font-weight: 600;
}

.chevron-right {
  color: var(--subtle-foreground);
}
