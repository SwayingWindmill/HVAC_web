<view class="login">
  <view class="brand">
    <view class="mark" aria-hidden="true"><image class="mark-icon" src="/assets/windmill/on-primary.svg" mode="aspectFit" /></view>
    <view class="name">泉来禾智慧能源</view>
    <view class="muted">冷站值班 · 用平台账号登录</view>
  </view>

  <view wx:if="{{step === 'password'}}" class="form">
    <view class="field">
      <text class="label">账号</text>
      <input class="input" value="{{username}}" bindinput="onUsername" placeholder="平台账号" maxlength="256" confirm-type="next" />
    </view>
    <view class="field">
      <text class="label">密码</text>
      <input class="input {{error ? 'input-error' : ''}}" value="{{password}}" bindinput="onPassword" password placeholder="密码" maxlength="512" confirm-type="done" bindconfirm="signIn" />
      <text wx:if="{{error}}" class="error">{{error}}</text>
    </view>
    <button class="button-primary" disabled="{{busy}}" loading="{{busy && busyButton === 'password'}}" bindtap="signIn">{{busy && busyButton === 'password' ? '登录中…' : '登录'}}</button>
    <view class="or" aria-hidden="true"><view class="or-line" /><text>绑定过微信的</text><view class="or-line" /></view>
    <button class="button-outline" disabled="{{busy}}" loading="{{busy && busyButton === 'wechat'}}" bindtap="signInWithWeChat"><image wx:if="{{!(busy && busyButton === 'wechat')}}" class="wechat-icon" src="/assets/wechat.svg" mode="aspectFit" aria-hidden="true" />{{busy && busyButton === 'wechat' ? '登录中…' : '微信一键登录'}}</button>
    <text wx:if="{{weChatError}}" class="error">{{weChatError}}</text>
    <text wx:else class="caption">微信一键登录要先在「我的」里绑定微信</text>
  </view>

  <view wx:else class="form">
    <view class="field">
      <text class="label">验证码</text>
      <text class="caption">这个账号开了验证码，请输入验证器里的 6 位数字。</text>
      <input class="input {{error ? 'input-error' : ''}}" value="{{code}}" bindinput="onCode" type="number" maxlength="6" placeholder="6 位数字" confirm-type="done" bindconfirm="completeTotp" />
      <text wx:if="{{error}}" class="error">{{error}}</text>
    </view>
    <button class="button-primary" disabled="{{busy}}" loading="{{busy}}" bindtap="completeTotp">{{busy ? '验证中…' : '登录'}}</button>
    <button class="button-outline" bindtap="startOver">换个账号</button>
  </view>

  <view class="footer caption">
    <view>没有账号？请管理员添加：</view>
    <view>网页「系统管理 → 用户与角色」</view>
  </view>
</view>
