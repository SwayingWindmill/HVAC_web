<view class="screen with-tab-bar">
  <view class="card card-pad person">
    <view class="avatar" aria-hidden="true">{{name ? name[0] : ''}}</view>
    <view class="person-text">
      <text class="person-name">{{name}}</text>
      <text class="caption">{{email}}</text>
    </view>
  </view>

  <view class="card">
    <picker wx:if="{{canSwitchTenant}}" mode="selector" range="{{tenants}}" range-key="displayName" value="{{tenantIndex}}" bindchange="switchTenant" disabled="{{switchingTenant}}">
      <view class="row" aria-role="button" aria-label="切换所属组织">
        <view class="titled"><text>当前组织</text></view>
        <view class="row-side"><text class="value">{{tenantName}}</text><image class="chev" src="/assets/icon/chevron-right.svg" aria-hidden="true" /></view>
      </view>
    </picker>
    <view class="row" bindtap="openSites" aria-role="button" aria-label="切换站点">
      <view class="titled"><image class="title-icon" src="/assets/icon/map-pin.svg" aria-hidden="true" /><text>当前站点</text></view>
      <text class="muted">{{siteName}} ›</text>
    </view>
    <view class="row" bindtap="tapWeChat" aria-role="button" aria-label="微信，{{wechat.value}}" aria-disabled="{{!wechat.action || changingWeChat}}">
      <view class="row-main">
        <view class="titled"><image class="title-icon" src="/assets/icon/message-circle.svg" aria-hidden="true" /><text>微信</text></view>
        <text wx:if="{{wechat.hint}}" class="caption">{{wechat.hint}}</text>
      </view>
      <text class="muted">{{wechat.value}}{{wechat.action ? ' ›' : ''}}</text>
    </view>
  </view>

  <button class="button-outline sign-out" disabled="{{signingOut}}" loading="{{signingOut}}" bindtap="signOut"><image wx:if="{{!signingOut}}" class="title-icon sign-out-icon" src="/assets/icon/log-out.svg" aria-hidden="true" />退出登录</button>
  <view class="caption hint">改密码、管理用户和站点，请到电脑上的网页。</view>
</view>
