.filter-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}

.chip {
  flex-shrink: 0;
  padding: 5px 12px;
  border: 1px solid var(--border);
  border-radius: 16px;
  background: var(--card);
  font-size: 13px;
  color: var(--secondary-foreground);
}

.chip-on {
  border-color: var(--primary-line);
  background: var(--primary-soft);
  color: #2f46b3;
  font-weight: 600;
}

.section {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 4px 4px 0;
}

.section-title {
  display: flex;
  align-items: baseline;
  gap: 6px;
  font-size: 15px;
  font-weight: 600;
}

.section-count {
  margin-left: 6px;
  font-family: "Geist Mono", ui-monospace, Menlo, monospace;
  font-weight: 500;
  color: var(--muted-foreground);
}

/* A Site day inside 最近恢复. */
.day {
  display: block;
  padding: 10px 16px 4px;
  font-size: 12px;
  font-weight: 600;
  color: var(--muted-foreground);
  background: var(--muted);
  border-top: 1px solid var(--divider);
}

.day:first-child {
  border-top: 0;
  border-radius: 12px 12px 0 0;
}

.alarm {
  display: flex;
  align-items: center;
  gap: 12px;
  min-height: 56px;
  padding: 10px 16px;
  border-top: 1px solid var(--divider);
}

.alarm:first-child,
.day + .alarm {
  border-top: 0;
}

.severity-mark {
  flex-shrink: 0;
  width: 10px;
  height: 10px;
}

.alarm-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.alarm-title {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 15px;
  line-height: 22px;
  font-weight: 600;
}

/* Whether someone is on it, in one column down the right to scan. */
.status {
  flex-shrink: 0;
  padding: 2px 8px;
  border-radius: 6px;
  background: var(--secondary);
  font-size: 12px;
  color: var(--muted-foreground);
}

.status-waiting {
  background: var(--warning-soft);
  color: var(--warning-text);
  font-weight: 600;
}

.legend {
  padding: 0 4px;
}
