.active {
  border-top: 1px solid var(--border);
}

.active-label {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 15px;
  font-weight: 600;
}

.active-mark {
  width: 10px;
  height: 10px;
}

.active-count {
  font-size: 15px;
  font-weight: 600;
  color: var(--secondary-foreground);
}

.toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}

.toolbar .segments {
  width: 180px;
}

.mark-all {
  font-size: 14px;
  color: var(--primary);
}

.mark-all-off {
  color: var(--subtle-foreground);
}

.group {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.group-day {
  padding: 0 4px;
  font-size: 13px;
  font-weight: 600;
  color: var(--secondary-foreground);
}

.notice {
  display: flex;
  flex-direction: column;
  gap: 4px;
  padding: 12px 16px;
  border-top: 1px solid var(--divider);
}

.notice:first-child {
  border-top: 0;
}

.notice-head {
  display: flex;
  align-items: center;
  gap: 8px;
}

.notice-tag {
  display: flex;
  align-items: center;
  gap: 5px;
  font-size: 12px;
  color: var(--secondary-foreground);
}

.severity-mark {
  width: 10px;
  height: 10px;
}

.notice-time {
  margin-left: auto;
  font-size: 12px;
  color: var(--muted-foreground);
}

.unread-dot {
  width: 8px;
  height: 8px;
  border-radius: 4px;
  background: var(--primary);
}

.notice-subject {
  font-size: 15px;
  line-height: 22px;
  color: var(--secondary-foreground);
}

.notice-unread .notice-subject {
  font-weight: 600;
  color: var(--foreground);
}

.notice-body {
  font-size: 13px;
  line-height: 20px;
  color: var(--muted-foreground);
}
