.filter-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}

.chip {
  flex-shrink: 0;
  padding: 5px 12px;
  border: 1px solid var(--border);
  border-radius: 16px;
  background: var(--card);
  font-size: 13px;
  color: var(--secondary-foreground);
}

.chip-on {
  border-color: var(--primary-line);
  background: var(--primary-soft);
  color: #2f46b3;
  font-weight: 600;
}

.section {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 4px 4px 0;
}

.section-title {
  font-size: 15px;
  font-weight: 600;
}

.alarm {
  display: flex;
  align-items: center;
  gap: 10px;
  min-height: 60px;
  padding: 10px 12px;
}

/* Severity as a soft-tinted label led by its shape, as the web's SeverityBadge. */
.severity-tag {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 4px;
  height: 20px;
  padding: 0 6px;
  border-radius: 6px;
  font-size: 11px;
  font-weight: 500;
}

.severity-critical { background: #fdeceb; color: #b42318; }
.severity-major { background: #fdefe6; color: #c2410c; }
.severity-minor { background: #fef3e2; color: #b45309; }
.severity-warning { background: #e7f3fb; color: #0369a1; }
.severity-info { background: #f4f4f5; color: #3f3f46; }

.severity-mark {
  width: 8px;
  height: 8px;
}

.alarm-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.alarm-title {
  font-size: 15px;
  line-height: 22px;
  font-weight: 600;
}

.chevron-right {
  color: var(--subtle-foreground);
}

.legend {
  padding: 0 4px;
}
