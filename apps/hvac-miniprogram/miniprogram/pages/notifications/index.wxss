.active {
  border-top: 1px solid var(--border);
}

.active-label {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 15px;
  font-weight: 600;
}

.active-mark {
  width: 18px;
  height: 18px;
}

.active-count {
  font-size: 15px;
  font-weight: 600;
  color: var(--secondary-foreground);
}

.toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}

.toolbar .segments {
  width: 180px;
}

.mark-all {
  font-size: 14px;
  color: var(--primary);
}

.mark-all-off {
  color: var(--subtle-foreground);
}

.group {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.group-day {
  padding: 0 4px;
  font-size: 13px;
  font-weight: 600;
  color: var(--secondary-foreground);
}

.notice {
  display: flex;
  gap: 8px;
  padding: 12px 16px 12px 8px;
  border-top: 1px solid var(--divider);
}

.unread-slot {
  flex-shrink: 0;
  width: 8px;
  padding-top: 7px;
}

.notice-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.notice:first-child {
  border-top: 0;
}

.notice-head {
  display: flex;
  align-items: center;
  gap: 8px;
}

/* Severity as a soft-tinted label led by its shape, as the web's SeverityBadge. */
.severity-tag {
  display: flex;
  align-items: center;
  gap: 4px;
  height: 20px;
  padding: 0 6px;
  border-radius: 6px;
  font-size: 11px;
  font-weight: 500;
}

.severity-critical { background: #fdeceb; color: #b42318; }
.severity-major { background: #fdefe6; color: #c2410c; }
.severity-minor { background: #fef3e2; color: #b45309; }
.severity-warning { background: #e7f3fb; color: #0369a1; }
.severity-info { background: #f4f4f5; color: #3f3f46; }

.severity-mark {
  width: 8px;
  height: 8px;
}

.notice-time {
  margin-left: auto;
  font-size: 12px;
  color: var(--muted-foreground);
}

.unread-dot {
  width: 8px;
  height: 8px;
  border-radius: 4px;
  background: var(--primary);
}

.notice-subject {
  font-size: 15px;
  line-height: 22px;
  color: var(--secondary-foreground);
}

.notice-unread .notice-subject {
  font-weight: 600;
  color: var(--foreground);
}

.notice-body {
  font-size: 13px;
  line-height: 20px;
  color: var(--muted-foreground);
}
