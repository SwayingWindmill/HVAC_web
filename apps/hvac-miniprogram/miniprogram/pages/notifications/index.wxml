<page-header title="通知" />

<view class="screen with-tab-bar">
  <view wx:if="{{loading}}" class="state">正在读取…</view>
  <view wx:elif="{{noSite}}" class="state">这个账号还看不到任何站点，请管理员在网页「系统管理」里分配站点。</view>
  <view wx:elif="{{failed}}" class="state">{{failed}}</view>
  <block wx:else>
    <view class="filter-bar">
      <text class="caption">{{siteName}} · 告警</text>
      <text class="chip {{unacknowledgedOnly ? 'chip-on' : ''}}" bindtap="toggleUnacknowledged" aria-role="checkbox" aria-checked="{{unacknowledgedOnly}}">只看没确认的</text>
    </view>

    <view wx:for="{{feed.sections}}" wx:for-item="section" wx:key="title" class="section">
      <view class="section-head">
        <text class="section-title">{{section.title}}</text>
        <text wx:if="{{section.caption}}" class="caption">{{section.caption}}</text>
      </view>
      <view wx:if="{{section.empty}}" class="card card-pad caption">{{section.empty}}</view>
      <view wx:for="{{section.rows}}" wx:key="alarmId" class="card alarm" data-id="{{item.alarmId}}" bindtap="open" aria-role="link" aria-label="{{item.severity}}，{{item.title}}，{{item.detail}}">
        <view class="severity-tag severity-{{item.level}}">
          <image class="severity-mark" src="/assets/severity/{{item.level}}.svg" aria-hidden="true" />
          <text>{{item.severity}}</text>
        </view>
        <view class="alarm-main">
          <text class="alarm-title">{{item.title}}</text>
          <text class="caption">{{item.detail}}</text>
        </view>
        <text class="chevron-right" aria-hidden="true">›</text>
      </view>
    </view>

    <text wx:if="{{partial}}" class="caption">正在发生的告警太多，这里只列出了前面的一部分，完整的在网页「告警」里看。</text>
    <text class="caption legend">形状代表严重程度：◆ 紧急 ▲ 重要 ● 次要 ■ 预警 ○ 提示</text>
  </block>
</view>
