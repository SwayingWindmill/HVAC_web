@import "../../styles/hour-chart.wxss";

.head {
  display: flex;
  align-items: center;
  gap: 8px;
}

.head .badge {
  align-self: center;
}

.head-time {
  margin-left: auto;
}

.lead {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
}

.lead-metric {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.lead-value {
  font-size: 26px;
  line-height: 32px;
  font-weight: 600;
  letter-spacing: -0.02em;
}

.energy {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.split {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.energy-total {
  font-size: 22px;
  line-height: 28px;
  font-weight: 600;
}

.reading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  min-height: 44px;
  padding: 0 16px;
  border-top: 1px solid var(--divider);
}

.reading-label {
  font-size: 14px;
  color: var(--secondary-foreground);
}

.reading-value {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 15px;
  font-weight: 600;
}
