/* Today's 24 hours as bars (lib/run.ts hourBars), shared by 运行 and the device page. */
.chart-body {
  display: grid;
  grid-template-columns: 30px minmax(0, 1fr);
  gap: 6px;
}

.chart-scale {
  height: 80px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  font-size: 10px;
  line-height: 12px;
  color: var(--muted-foreground);
  text-align: right;
}

.chart-bars {
  height: 80px;
  display: flex;
  align-items: flex-end;
  gap: 2px;
  border-bottom: 1px solid var(--border);
}

.bar {
  flex: 1;
}

.bar-value {
  background: var(--primary);
  border-radius: 3px 3px 0 0;
}

.bar-idle {
  height: 2px;
  background: var(--border);
}

.bar-missing {
  height: 50%;
  background: repeating-linear-gradient(135deg, #d4d4d8 0 1.5px, transparent 1.5px 5px);
}

.chart-hours {
  display: flex;
  justify-content: space-between;
  font-size: 11px;
  color: var(--muted-foreground);
}

.legend {
  display: flex;
  flex-wrap: wrap;
  gap: 6px 14px;
  font-size: 12px;
  color: var(--muted-foreground);
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 5px;
}

.swatch {
  width: 10px;
  height: 10px;
  border-radius: 2px;
}

.swatch-value { background: var(--primary); }
.swatch-idle { height: 2px; background: #c4c4c8; }
.swatch-missing { background: repeating-linear-gradient(135deg, #a1a1aa 0 1.5px, transparent 1.5px 4px); }
