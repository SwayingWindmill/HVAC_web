.bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  height: 64px;
  padding-bottom: env(safe-area-inset-bottom);
  background: #ffffff;
  border-top: 1px solid #e7e7ea;
}

.tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 3px;
  color: #71717a;
}

.tab-on {
  color: #3f5bd9;
  font-weight: 600;
}

.icon {
  width: 22px;
  height: 22px;
}

.label {
  font-size: 11px;
  line-height: 14px;
}
