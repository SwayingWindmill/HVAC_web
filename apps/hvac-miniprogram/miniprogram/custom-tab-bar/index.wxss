.bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  height: 64px;
  padding-bottom: env(safe-area-inset-bottom);
  background: #ffffff;
  border-top: 1px solid #e7e7ea;
}

.tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 3px;
  color: #71717a;
}

.tab-on {
  color: #3f5bd9;
  font-weight: 600;
}

.icon {
  width: 22px;
  height: 22px;
}

.label {
  font-size: 11px;
  line-height: 14px;
}

/* The assistant: a round primary button standing above the bar, always in the primary colour. */
.tab-raised {
  position: relative;
  justify-content: flex-end;
  padding-bottom: 9px;
  color: #3f5bd9;
  font-weight: 600;
}

/* Stands above the bar; the orb's own position: relative must not win, hence the two classes. */
.raised.orb {
  position: absolute;
  top: -22px;
  width: 58px;
  height: 58px;
  border-radius: 29px;
  box-shadow: 0 8px 22px rgba(63, 91, 217, 0.38), 0 2px 6px rgba(47, 70, 179, 0.3);
}

.raised-icon {
  width: 34px;
  height: 34px;
}

/*
 * The assistant's orb (#677): indigo light flowing round against the windmill's turn, as wind through
 * the blades, under a soft highlight; no white ring. The flow is the one place the design system's
 * no-gradient rule gives way, at the user's request, and it stays within the indigo family.
 */
.orb {
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #3f5bd9;
  /* Keeps the rounded clip on the turning layer in iOS WebKit, which overflow alone does not. */
  transform: translateZ(0);
  -webkit-mask-image: -webkit-radial-gradient(white, black);
}

.orb-flow {
  position: absolute;
  top: -30%;
  left: -30%;
  width: 160%;
  height: 160%;
  background: conic-gradient(from 0deg, #2f46b3, #3f5bd9 18%, #6a7cff 36%, #8b7bff 48%, #4a63e3 64%, #2f46b3 82%, #3f5bd9);
}

.orb-sheen {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: radial-gradient(circle at 32% 24%, rgba(255, 255, 255, 0.32), rgba(255, 255, 255, 0) 58%);
}

.orb-icon {
  position: relative;
}

@keyframes orb-flow {
  from { transform: rotate(360deg); }
  to { transform: rotate(0deg); }
}

/* Against the windmill: it turns clockwise every 12 s, the light flows back every 6 s. */
.orb-flowing {
  animation: orb-flow 6s linear infinite;
}


/* The windmill turns (app.wxss); a tab bar component does not see the page's styles. */
@keyframes windmill-turn {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.windmill {
  animation: windmill-turn 12s linear infinite;
}

.tab {
  position: relative;
}

/* Alarms happening with no one on them, on the 通知 tab. */
.badge-count {
  position: absolute;
  top: 6px;
  left: 56%;
  min-width: 18px;
  height: 18px;
  box-sizing: border-box;
  padding: 0 5px;
  border-radius: 9px;
  background: #d92d20;
  color: #ffffff;
  font-size: 11px;
  font-weight: 600;
  line-height: 18px;
  text-align: center;
}
