.bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  height: 64px;
  padding-bottom: env(safe-area-inset-bottom);
  background: #ffffff;
  border-top: 1px solid #e7e7ea;
}

.tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 3px;
  color: #71717a;
}

.tab-on {
  color: #3f5bd9;
  font-weight: 600;
}

.icon {
  width: 22px;
  height: 22px;
}

.label {
  font-size: 11px;
  line-height: 14px;
}

/* The assistant: a round primary button standing above the bar, always in the primary colour. */
.tab-raised {
  position: relative;
  justify-content: flex-end;
  padding-bottom: 9px;
  color: #3f5bd9;
  font-weight: 600;
}

/*
 * Rises only 8px above the bar, so it covers almost nothing of the page; the orb's own
 * position: relative must not win, hence the two classes.
 */
.raised.orb {
  position: absolute;
  top: -8px;
  width: 46px;
  height: 46px;
  border-radius: 23px;
  box-shadow: 0 6px 14px rgba(63, 91, 217, 0.32), 0 2px 4px rgba(63, 91, 217, 0.24);
}

.raised-icon {
  width: 28px;
  height: 28px;
}

/*
 * The assistant's orb (#677): indigo light flowing round against the windmill's turn, as wind through
 * the blades, under a soft highlight; no white ring. The flow is the one place the design system's
 * no-gradient rule gives way, at the user's request, and it stays within the indigo family.
 */
.orb {
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #3f5bd9;
  /* Keeps the rounded clip on the turning layer in iOS WebKit, which overflow alone does not. */
  transform: translateZ(0);
  -webkit-mask-image: -webkit-radial-gradient(white, black);
}

.orb-flow {
  position: absolute;
  top: -30%;
  left: -30%;
  width: 160%;
  height: 160%;
  background: conic-gradient(from 0deg, #3f5bd9, #4f69e6 20%, #7186f5 38%, #8f9cff 50%, #6178ef 66%, #4a63e0 84%, #3f5bd9);
}

.orb-sheen {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  border-radius: inherit;
  background:
    radial-gradient(circle at 30% 22%, rgba(255, 255, 255, 0.5), rgba(255, 255, 255, 0) 42%),
    radial-gradient(circle at 72% 90%, rgba(30, 44, 140, 0.22), rgba(30, 44, 140, 0) 58%);
  box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.6), inset 0 -2px 4px rgba(30, 44, 140, 0.22);
}


/* Above the light, and standing off the sphere. */
.orb-icon {
  position: relative;
  filter: drop-shadow(0 1px 1.5px rgba(30, 44, 140, 0.35));
}

@keyframes orb-flow {
  from { transform: rotate(360deg); }
  to { transform: rotate(0deg); }
}

/* Against the windmill: it turns clockwise every 12 s, the light flows back every 6 s. */
.orb-flowing {
  animation: orb-flow 6s linear infinite;
}


/* The windmill turns (app.wxss); a tab bar component does not see the page's styles. */
@keyframes windmill-turn {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.windmill {
  animation: windmill-turn 12s linear infinite;
}

.tab {
  position: relative;
}

/* Alarms happening with no one on them, on the 通知 tab. */
.badge-count {
  position: absolute;
  top: 6px;
  left: 56%;
  min-width: 18px;
  height: 18px;
  box-sizing: border-box;
  padding: 0 5px;
  border-radius: 9px;
  background: #d92d20;
  color: #ffffff;
  font-size: 11px;
  font-weight: 600;
  line-height: 18px;
  text-align: center;
}
