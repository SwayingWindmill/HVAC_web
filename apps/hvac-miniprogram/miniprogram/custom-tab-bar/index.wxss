.bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  height: 64px;
  padding-bottom: env(safe-area-inset-bottom);
  background: #ffffff;
  border-top: 1px solid #e7e7ea;
}

.tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 3px;
  color: #71717a;
}

.tab-on {
  color: #3f5bd9;
  font-weight: 600;
}

.icon {
  width: 22px;
  height: 22px;
}

.label {
  font-size: 11px;
  line-height: 14px;
}

/* The assistant: a round primary button standing above the bar, always in the primary colour. */
.tab-raised {
  position: relative;
  justify-content: flex-end;
  padding-bottom: 9px;
  color: #3f5bd9;
  font-weight: 600;
}

.raised {
  position: absolute;
  top: -20px;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56px;
  height: 56px;
  border-radius: 28px;
  background: #3f5bd9;
  box-shadow: 0 0 0 4px #ffffff, 0 8px 20px rgba(63, 91, 217, 0.35);
}

.raised-icon {
  width: 28px;
  height: 28px;
}

/* The windmill turns (app.wxss); a tab bar component does not see the page's styles. */
@keyframes windmill-turn {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.windmill {
  animation: windmill-turn 12s linear infinite;
}

.tab {
  position: relative;
}

/* Alarms happening with no one on them, on the 通知 tab. */
.badge-count {
  position: absolute;
  top: 6px;
  left: 56%;
  min-width: 18px;
  height: 18px;
  box-sizing: border-box;
  padding: 0 5px;
  border-radius: 9px;
  background: #d92d20;
  color: #ffffff;
  font-size: 11px;
  font-weight: 600;
  line-height: 18px;
  text-align: center;
}
