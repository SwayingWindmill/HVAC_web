<view class="bar">
  <view
    wx:for="{{tabs}}"
    wx:key="pagePath"
    class="tab {{selected === index ? 'tab-on' : ''}} {{item.raised ? 'tab-raised' : ''}}"
    data-index="{{index}}"
    bindtap="switchTab"
    aria-role="tab"
    aria-selected="{{selected === index}}"
    aria-label="{{item.text}}"
  >
    <view wx:if="{{item.raised}}" class="raised" aria-hidden="true"><image class="raised-icon" src="{{item.icon}}" mode="aspectFit" /></view>
    <image wx:else class="icon" src="{{selected === index ? item.activeIcon : item.icon}}" mode="aspectFit" />
    <text class="label">{{item.text}}</text>
  </view>
</view>
