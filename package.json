    "dev:s0-gateway": "node scripts/dev-platform-gateway.mjs",
    "dev:s0-auth": "node scripts/dev-s0-auth.mjs",
    "dev:s0-durable": "node scripts/dev-s0-durable.mjs",
    "delivery:local": "node scripts/dev-s0-durable.mjs",
    "delivery:validate": "node scripts/validate-s0-delivery-config.mjs --file=deploy/s0/local.env.example && node scripts/validate-s0-delivery-config.mjs --file=deploy/s0/staging.env.example",
    "delivery:check": "node scripts/check-s0-delivery-assets.mjs && node scripts/test-render-s0-staging.mjs",
    "delivery:render": "node scripts/render-s0-staging.mjs",
    "security:dependency-audit": "node scripts/check-npm-production-audit.mjs",
    "security:go-vuln": "node scripts/run-go-vulnerability-scan.mjs",
    "security:licenses": "node scripts/check-production-licenses.mjs",
    "security:failure-assets": "node scripts/check-s0-security-failure-assets.mjs",
    "security:network-policies": "node scripts/check-s0-network-policies.mjs",
    "test:security-negative": "node scripts/run-go.mjs test -count=1 ./libs/identitycontext/... ./libs/oidctest/... ./libs/ownershipregistry/... ./libs/registryauth/... ./libs/telemetryauth/... ./services/iam-service/... ./services/legacy-migration-service/... ./services/platform-core-service/... ./services/audit-ledger-service/... ./services/outbox-relay/... ./services/platform-gateway/...",
    "audit:security-failure": "node scripts/run-durable-session-browser-audit.mjs",
    "security:gates": "node scripts/run-s0-security-failure-gates.mjs",
    "dev:energy-agent": "uv run --directory agents/energy-agent langgraph dev --config langgraph.json --port 8123 --no-browser",
    "dev:ai-runtime": "node runtimes/copilot-runtime/server.mjs",
    "dev:energyagent": "node scripts/dev-energyagent.mjs",
    "verify:ai-runtime": "node scripts/verify-ai-runtime.mjs",
    "verify:energyagent-stack": "node scripts/verify-energyagent-stack.mjs",
    "contracts:generate": "node scripts/generate-platform-contracts.mjs",
    "contracts:check": "node scripts/generate-platform-contracts.mjs --check",
    "events:check": "node scripts/check-session-event-contract.mjs",
    "ownership:check": "node scripts/check-ownership-registries.mjs",
