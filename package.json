{
  "name": "hvac-platform",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "preinstall": "node scripts/check-web-js-runtime.mjs --install",
    "web:runtime:check": "node scripts/check-web-js-runtime.mjs",
    "ui:shadcn": "npm -w @hvac/web run ui:shadcn --",
    "repo:check": "node --experimental-strip-types scripts/check-repository-governance.ts",
    "repo:clean:local": "node scripts/clean-local-workspace.mjs",
    "repo:long-chains:update": "node --experimental-strip-types scripts/update-package-script-long-chain-baseline.mjs",
    "check": "node scripts/run-pr-gate.mjs --gate=static",
    "test": "node scripts/run-pr-gate.mjs --gate=unit --profile-set=all",
    "domain:run": "node scripts/run-domain-task.mjs",
    "domain:plan": "node scripts/run-domain-task.mjs --dry-run=true",
    "dev": "npm run web:runtime:check && npm -w @hvac/web run dev",
    "dev:web": "npm run dev",
    "frontend:preview": "HVAC_WEB_FRONTEND_REVIEW=true npm -w @hvac/web run build && HVAC_WEB_FRONTEND_REVIEW=true npm -w @hvac/web run preview -- --host 127.0.0.1 --port 5175 --strictPort",
    "architecture:phase1:check": "node scripts/check-phase1-architecture-alignment.mjs",
    "data:architecture:check": "node scripts/check-data-architecture-v2.mjs",
    "backend:architecture:check": "node --experimental-strip-types scripts/check-backend-architecture-v2.ts",
    "deployment:phase1:check": "node scripts/check-phase1-deployment.mjs",
    "migrations:freeze:check": "node --experimental-strip-types scripts/check-migration-freeze.ts",
    "deployment:phase1:compose": "node --experimental-strip-types scripts/phase1-compose.ts",
    "deployment:phase1:owner-split:drill": "node --experimental-strip-types scripts/run-phase1-owner-split-drill.ts",
    "deployment:phase1:wsl": "node scripts/phase1-wsl-compose.mjs",
    "local:up": "node scripts/local-environment.mjs up",
    "local:down": "node scripts/local-environment.mjs down",
    "local:ps": "node scripts/local-environment.mjs ps",
    "local:reset": "node scripts/local-environment.mjs reset",
    "deployment:phase1:identity-reset": "node scripts/phase1-reset-local-identity-password.mjs",
    "deployment:phase1:local-foundation": "node scripts/phase1-bootstrap-local-foundation.mjs",
    "deployment:phase1:simulator": "node scripts/phase1-central-plant-simulator.mjs",
    "deployment:phase1:recovery:verify": "node scripts/verify-phase1-recovery-drill.mjs",
    "deployment:phase1:recovery:claim:check": "node --experimental-strip-types scripts/check-phase1-recovery-attainment.ts",
    "deployment:phase1:process-failure:plan": "node --experimental-strip-types scripts/run-phase1-process-failure-drill.ts --plan",
    "deployment:phase1:migration:test": "node scripts/run-phase1-migration-integration.mjs",
    "pr:gates:classify": "node scripts/classify-pr-gates.mjs",
    "pr:gates:test": "node --experimental-strip-types --test scripts/test-pr-gate-classifier.mjs scripts/test-domain-task-matrix.mjs scripts/test-migration-freeze.ts",
    "security:dependency-audit": "node scripts/check-npm-production-audit.mjs",
