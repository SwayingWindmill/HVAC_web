    "s2:centrifugo:poc": "node scripts/run-s2-centrifugo-poc.mjs",
    "s2:ownership:check": "node scripts/check-s2-telemetry-ownership.mjs",
    "s2:public-contract:check": "node scripts/check-s2-telemetry-public-contract.mjs",
    "s2:rollout-gates:check": "node scripts/check-s2-telemetry-rollout-gates.mjs",
    "s2:implementation-plan:check": "node scripts/check-s2-implementation-plan.mjs",
    "s2:contracts:generate": "node scripts/generate-s2-telemetry-contracts.mjs",
    "s2:contracts:check": "node scripts/generate-s2-telemetry-contracts.mjs --check",
    "s2:baseline:check": "node scripts/check-s2-telemetry-baseline.mjs",
    "s2:postgres": "node scripts/run-s2-telemetry-postgres-tests.mjs",
    "s2:ticket-01": "npm run s2:contracts:check && npm run ownership:check && npm run s2:baseline:check && npm run s2:ownership:check && npm run s2:public-contract:check && npm run s2:rollout-gates:check && npm run s2:implementation-plan:check && npm run contracts:check && npm run release:evidence-assets && npm run s1:registry:check && npm run test:ownership && npm run test:registry-routing && node scripts/run-go.mjs test ./services/telemetry-runtime-service/... && npm run lint && npm run build && npm run s2:postgres",
    "s2:iam:check": "node scripts/check-s2-iam-authorization.mjs",
    "s2:iam:postgres": "node scripts/run-s2-iam-postgres-tests.mjs",
    "s2:ticket-02": "npm run s2:iam:check && node scripts/run-go.mjs test ./libs/telemetryauth/... && node scripts/run-go.mjs test ./services/iam-service/... && npm run ownership:check && npm run s2:baseline:check && npm run s1:registry:check && npm run release:evidence-assets && npm run lint && npm run build && npm run s2:iam:postgres",
    "pocs:components:docker": "node scripts/run-platform-component-docker-pocs.mjs",
    "pocs:components:envoy": "node scripts/run-platform-component-envoy-poc.mjs",
    "pocs:components": "npm run pocs:components:check && npm run pocs:components:docker && npm run pocs:components:envoy",
    "s1:registry:check": "node scripts/check-s1-registry-baseline.mjs",
    "s1:registry:postgres": "node scripts/run-s1-registry-postgres-tests.mjs",
    "s1:hvac-web:check": "node scripts/check-s1-hvac-web-registry.mjs",
    "s1:hvac-web:build": "node scripts/build-s1-hvac-web-registry.mjs",
    "audit:s1-hvac-web-registry": "node scripts/run-s1-hvac-web-registry-browser-audit.mjs --report=out/s1-ticket-06/hvac-web-registry-browser.json",
    "s1:sqlc:poc": "node scripts/run-s1-sqlc-poc.mjs",
    "s1:logto:poc": "node scripts/run-s1-logto-sdk-adoption-poc.mjs",
    "s1:ticket-01": "npm run contracts:check && npm run ownership:check && npm run s1:registry:check && npm run s1:sqlc:poc && npm run s1:registry:postgres",
    "s1:ticket-03": "npm run contracts:check && npm run ownership:check && npm run s1:registry:check && npm run test:identity && npm run build:core && npm run build:iam && npm run s1:registry:postgres",
    "s1:ticket-04": "npm run contracts:check && npm run ownership:check && npm run s1:registry:check && npm run test:legacy-migration && npm run build:legacy-migration && npm run s1:registry:postgres",
    "s1:ticket-05": "npm run contracts:check && npm run ownership:check && npm run s1:registry:check && npm run test:registry-routing && npm run build:gateway && npm run build:legacy-compatibility && npm run s1:registry:postgres",
    "s1:ticket-06": "npm run contracts:check && npm run s1:registry:check && npm run s1:hvac-web:check && npm run lint && npm run s1:hvac-web:build && npm run audit:s1-hvac-web-registry",
    "audit:delivery": "npm run delivery:validate && npm run delivery:check && npm run audit:s0-rollout && npm run test:durable-postgres",
    "build": "tsc -b apps/hvac-web/tsconfig.json && vite build apps/hvac-web --config apps/hvac-web/vite.config.ts",
    "preview": "vite preview apps/hvac-web --config apps/hvac-web/vite.config.ts",
    "lint": "tsc -p apps/hvac-web/tsconfig.json --noEmit",
    "audit:ui": "node scripts/run-browser-audit.mjs scripts/ui-audit.mjs",
    "audit:bigscreen": "node scripts/run-browser-audit.mjs scripts/bigscreen-layout-audit.mjs",
    "audit:ops-loop": "node scripts/run-browser-audit.mjs scripts/ops-loop-audit.mjs",
    "audit:all": "node scripts/audit-all.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "^5.5.1",
    "@copilotkit/react-core": "^1.62.3",
    "@copilotkit/runtime": "^1.62.3",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@tanstack/react-query": "^5.59.0",
    "antd": "^5.21.4",
    "axios": "^1.7.7",
    "echarts": "^5.5.1",
    "echarts-for-react": "^3.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0",
    "rxjs": "7.8.1",
    "socket.io-client": "^4.8.3",
    "three": "^0.185.1",
    "zod": "^3.25.76",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.9",
    "ws": "^8.21.0"
  },
  "overrides": {
    "@hono/node-server": "2.0.11",
    "dompurify": "3.4.12",
    "fast-uri": "3.1.4"
  }
}
