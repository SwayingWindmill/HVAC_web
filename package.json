    "mqtt:e2e:integration": "node scripts/run-mqtt-e2e-tests.mjs",
    "test:gateway": "node scripts/run-go.mjs test ./cmd/energy-api/...",
    "test:analytics": "node scripts/run-go.mjs test ./libs/analyticsmodel/... ./libs/intelligencemodel/... ./modules/energy/... ./modules/telemetry/... ./modules/metric/... ./modules/scheduler/... ./cmd/metric-worker/... ./services/forecast-service/... ./services/optimization-service/... ./services/fdd-service/... ./services/mv-service/... ./services/report-service/... ./libs/tariffmodel/...",
    "analytics:history:check": "node scripts/check-analytics-history.mjs",
    "analytics:history:integration": "node scripts/run-analytics-history-tests.mjs && node scripts/run-analytics-cube-tests.mjs",
    "test:analytics-gateway": "node scripts/run-go.mjs test ./libs/analyticsmodel/... ./libs/identitycontext/... ./libs/ownershipregistry/... ./modules/iam/... ./cmd/energy-api/... ./modules/telemetry/...",
    "test:identity": "node scripts/run-go.mjs test ./libs/identitycontext/... ./libs/oidctest/... ./libs/registryauth/... ./libs/telemetryauth/... ./libs/testpki/... ./libs/sessionstore/... ./services/identity-service/... ./modules/iam/... ./modules/registry/... ./modules/telemetry/... ./cmd/energy-api/...",
    "test:durable-unit": "node scripts/run-go.mjs test ./libs/observability/... ./libs/operationsauditevent/... ./libs/sessionevent/... ./libs/sessionstore/... ./modules/audit/... ./services/outbox-relay/... ./cmd/energy-api/...",
    "test:registry-routing": "node scripts/run-go.mjs test ./libs/identitycontext/... ./libs/ownershipregistry/... ./cmd/energy-api/...",
    "test:durable-postgres": "node scripts/run-durable-postgres-tests.mjs",
    "test:identity-postgres": "node --experimental-strip-types scripts/run-identity-postgres-tests.ts",
    "test:notification-postgres": "node --experimental-strip-types scripts/run-notification-postgres-tests.ts",
    "telemetry:contracts:generate": "node scripts/generate-s2-telemetry-contracts.mjs",
    "telemetry:contracts:check": "node scripts/generate-s2-telemetry-contracts.mjs --check",
    "telemetry:public-contract:check": "node scripts/check-s2-telemetry-public-contract.mjs",
    "telemetry:integration": "node scripts/run-s2-telemetry-postgres-tests.mjs && node scripts/run-s2-telemetry-ingest-postgres-tests.mjs && node scripts/run-s2-realtime-postgres-tests.mjs && node scripts/run-s2-telemetry-history-tests.mjs",
    "telemetry:browser": "node scripts/run-s2-telemetry-live-browser-audit.mjs",
    "registry:check": "node scripts/check-s1-registry-baseline.mjs",
    "registry:integration": "node scripts/run-s1-registry-postgres-tests.mjs",
    "typecheck:web": "npm run web:runtime:check && npm -w @hvac/web run typecheck",
    "build": "npm -w @hvac/web run build",
    "preview": "npm run web:runtime:check && npm -w @hvac/web run preview",
    "lint": "npm run web:runtime:check && npm -w @hvac/web run lint",
    "design:check": "node scripts/check-design-system.mjs",
    "observability:phase1:check": "node scripts/check-observability-phase1.mjs",
    "acceptance:phase1:check": "node scripts/check-phase1-simulator-acceptance.mjs",
    "acceptance:phase1:restore": "node scripts/run-phase1-postgres-restore-test.mjs",
    "acceptance:phase1:assemble": "node scripts/assemble-phase1-simulator-acceptance.mjs",
    "acceptance:phase1": "npm run acceptance:phase1:check && node scripts/run-phase1-simulator-acceptance.mjs --profile=simulator",
    "acceptance:phase1:rig:config": "node scripts/generate-acceptance-plant-config.mjs",
    "acceptance:phase1:rig:seed": "node scripts/phase1-central-plant-simulator.mjs --rig deploy/acceptance/phase1-simulator-rig.v1.json",
    "acceptance:phase1:rig:check": "node scripts/check-phase1-acceptance-rig.mjs",
    "test:dependency-audit-retry": "node scripts/test-npm-production-audit-retry.mjs",
    "codegraph:init": "codegraph init .",
    "codegraph:sync": "codegraph sync .",
    "codegraph:status": "codegraph status ."
  },
  "engines": {
    "node": ">=22.22.0"
  },
