    "test:eg8200-simulator": "npm run eg8200:config:check && node scripts/run-go.mjs test ./tools/eg8200-simulator/...",
    "build:connectivity": "node scripts/run-go.mjs build -o out/connectivity ./cmd/connectivity",
    "build:mqtt-telemetry-adapter-image": "docker build -f modules/connectivity/Dockerfile -t hvac/mqtt-telemetry-adapter:local .",
    "build:eg8200-mqtt-publisher": "node scripts/run-go.mjs build -o out/eg8200-mqtt-publisher ./tools/eg8200-simulator/cmd/eg8200-mqtt-publisher",
    "test:mqtt-telemetry-adapter": "node scripts/run-go.mjs test ./cmd/connectivity/... ./modules/connectivity/... ./tools/eg8200-simulator/... ./modules/telemetry/...",
