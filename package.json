    "build:iam": "node scripts/run-go.mjs build -o out/iam-service ./services/iam-service/cmd/iam-service",
    "build:iam-reconciler": "node scripts/run-go.mjs build -o out/iam-reconciler ./services/iam-service/cmd/iam-reconciler",
    "build:core": "node scripts/run-go.mjs build -o out/platform-core-service ./services/platform-core-service/cmd/platform-core-service",
    "build:legacy-migration": "node scripts/run-go.mjs build -o out/legacy-registry-migrator ./services/legacy-migration-service/cmd/legacy-registry-migrator",
    "build:oidc-fixture": "node scripts/run-go.mjs build -o out/oidc-test-provider ./services/oidc-test-provider/cmd/oidc-test-provider",
    "build:audit-ledger": "node scripts/run-go.mjs build -o out/audit-ledger-service ./services/audit-ledger-service/cmd/audit-ledger-service",
    "build:outbox-relay": "node scripts/run-go.mjs build -o out/outbox-relay ./services/outbox-relay/cmd/outbox-relay",
    "build:legacy-compatibility": "node scripts/run-go.mjs build -o out/legacy-private-fixture ./tools/legacy-private-fixture/cmd/legacy-private-fixture",
    "test:gateway": "node scripts/run-go.mjs test ./services/platform-gateway/...",
    "test:identity": "node scripts/run-go.mjs test ./libs/identitycontext/... ./libs/oidctest/... ./libs/registryauth/... ./libs/telemetryauth/... ./libs/testpki/... ./services/iam-service/... ./services/platform-core-service/... ./services/platform-gateway/...",
    "test:durable-unit": "node scripts/run-go.mjs test ./libs/observability/... ./libs/sessionevent/... ./libs/sessionstore/... ./services/audit-ledger-service/... ./services/outbox-relay/... ./services/platform-gateway/...",
    "test:observability": "node scripts/check-observability-assets.mjs && node scripts/run-go.mjs test ./libs/observability/... ./libs/sessionevent/... ./libs/sessionstore/... ./services/iam-service/... ./services/platform-core-service/... ./services/platform-gateway/... ./services/outbox-relay/... ./services/audit-ledger-service/...",
    "test:ownership": "node scripts/run-go.mjs test ./libs/ownershipregistry/... ./services/platform-gateway/...",
    "test:registry-routing": "node scripts/run-go.mjs test ./libs/identitycontext/... ./libs/ownershipregistry/... ./services/platform-gateway/... ./tools/legacy-private-fixture/...",
    "test:legacy-compatibility": "node scripts/run-go.mjs test ./tools/legacy-private-fixture/...",
    "test:legacy-migration": "node scripts/run-go.mjs test ./services/legacy-migration-service/...",
    "test:durable-postgres": "node scripts/run-durable-postgres-tests.mjs",
    "audit:platform-gateway": "node scripts/run-platform-gateway-browser-audit.mjs",
    "audit:auth-principal": "node scripts/run-auth-principal-browser-audit.mjs",
    "audit:durable-session": "node scripts/run-durable-session-browser-audit.mjs",
    "audit:route-ownership": "node scripts/run-durable-session-browser-audit.mjs",
    "audit:observability": "node scripts/run-durable-session-browser-audit.mjs",
    "audit:s0-rollout": "node scripts/audit-s0-rollout.mjs",
    "audit:s0-kind-rollout": "node scripts/run-s0-kind-rollout.mjs",
    "release:evidence-assets": "node scripts/check-s0-release-evidence-assets.mjs",
    "release:evidence:images": "node scripts/verify-s0-release-images.mjs",
    "release:evidence:build": "node scripts/build-s0-release-evidence.mjs",
    "test:release-evidence": "node scripts/test-s0-release-evidence.mjs",
