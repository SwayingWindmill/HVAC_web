    "alarm:test": "node --experimental-strip-types --test scripts/test-real-alarms.mjs",
    "notification:check": "node scripts/check-s16-notification.mjs",
    "events:check": "node scripts/check-session-event-contract.mjs",
    "ownership:check": "node scripts/check-ownership-registries.mjs",
    "build:energy-api": "node scripts/run-go.mjs build -o out/energy-api ./cmd/energy-api",
    "build:scheduler": "node scripts/run-go.mjs build -o out/scheduler ./cmd/scheduler",
    "build:maintenance-worker": "node scripts/run-go.mjs build -o out/maintenance-worker ./cmd/maintenance-worker",
    "build:metric-worker": "node scripts/run-go.mjs build -o out/metric-worker ./cmd/metric-worker",
    "build:iam-owner": "node scripts/run-go.mjs build -o out/iam-owner ./modules/iam/cmd/iam-owner",
    "build:identity-reconciler": "node scripts/run-go.mjs build -o out/identity-reconciler ./modules/iam/cmd/identity-reconciler",
    "build:registry-owner": "node scripts/run-go.mjs build -o out/registry-owner ./modules/registry/cmd/registry-owner",
    "build:telemetry-worker": "node scripts/run-go.mjs build -o out/telemetry-worker ./cmd/telemetry-worker",
    "build:telemetry-history-projector": "node scripts/run-go.mjs build -o out/telemetry-history-projector ./modules/telemetry/cmd/telemetry-history-projector",
    "build:telemetry-query-owner": "node scripts/run-go.mjs build -o out/telemetry-query-owner ./modules/telemetry/cmd/telemetry-query-owner",
    "build:telemetry-query-image": "docker build -f deploy/analytics/images/telemetry-query.Dockerfile -t hvac/telemetry-query:local .",
    "build:analytics-read-model-projector": "node scripts/run-go.mjs build -o out/analytics-read-model-projector ./modules/energy/cmd/energy-projector",
    "build:analytics-read-model-projector-image": "docker build -f deploy/analytics/images/analytics-read-model-projector.Dockerfile -t hvac/analytics-read-model-projector:local .",
    "build:command-owner": "node scripts/run-go.mjs build -o out/command-owner ./modules/command/cmd/command-owner",
    "build:alarm-owner": "node scripts/run-go.mjs build -o out/alarm-owner ./modules/alarm/cmd/alarm-owner",
    "build:work-order-owner": "node scripts/run-go.mjs build -o out/work-order-owner ./modules/workorder/cmd/work-order-owner",
