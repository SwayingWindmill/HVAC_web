{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hvac.local/contracts/operations-agent/trusted-runtime-context/v1",
  "title": "Operations Agent Trusted Runtime Context v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "source", "trust", "investigationId", "scope", "revision", "runId", "runStatus", "runtimeRevision", "allowedReadTools", "effectPolicy", "scopePolicy", "untrustedContentPolicy"],
  "properties": {
    "schemaVersion": {"const": 1},
    "source": {"const": "APPLICATION_POLICY"},
    "trust": {"const": "TRUSTED_CONTROL"},
    "investigationId": {"type": "string", "minLength": 1, "maxLength": 256},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tenantId", "siteId", "assetId", "deviceId"],
      "properties": {
        "tenantId": {"type": "string", "minLength": 1, "maxLength": 256},
        "siteId": {"type": ["string", "null"], "minLength": 1, "maxLength": 256},
        "assetId": {"type": ["string", "null"], "minLength": 1, "maxLength": 256},
        "deviceId": {"type": ["string", "null"], "minLength": 1, "maxLength": 256}
      }
    },
    "revision": {"type": "integer", "minimum": 0},
    "runId": {"type": "string", "minLength": 1, "maxLength": 256},
    "runStatus": {"const": "ACTIVE"},
    "runtimeRevision": {"type": "string", "minLength": 1, "maxLength": 256},
    "allowedReadTools": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["registry.getSite", "registry.listSiteAssets", "telemetry.getCurrentSnapshot", "analytics.getEnergySeries", "commands.getCapabilities"]
      }
    },
    "effectPolicy": {"const": "READ_ONLY"},
    "scopePolicy": {"const": "EXACT_INVESTIGATION_SCOPE"},
    "untrustedContentPolicy": {"const": "EXCLUDED"}
  }
}
