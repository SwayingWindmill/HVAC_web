{
  "openapi": "3.1.0",
  "info": {
    "title": "S4 Alarm Public API — SE-DOMAIN-ALARM-001 subordinate contract",
    "version": "2.1.2",
    "description": "Alarm Domain subordinate public contract. SE-DOMAIN-ALARM-001 V1.0 freezes public Site scope, cursor pagination, BOLA-safe resource resolution, ACK request shape, permission and idempotency semantics. Existing S4 Alarm remains the canonical Alarm resource."
  },
  "x-authority": "SE-DOMAIN-ALARM-001 V1.0 CURRENT CANDIDATE",
  "paths": {
    "/api/v1/alarms": {
      "get": {
        "operationId": "listAlarms",
        "x-owner": "alarm-service",
        "x-public-ingress": "platform-gateway",
        "x-architecture-status": "ACTIVE",
        "x-shape-status": "READY",
        "parameters": [
          { "$ref": "#/components/parameters/SiteIdRequired" },
          { "$ref": "#/components/parameters/Limit" },
          { "$ref": "#/components/parameters/Cursor" },
          { "$ref": "#/components/parameters/AlarmSeverity" },
          { "$ref": "#/components/parameters/AlarmStatus" }
        ],
        "responses": {
          "200": {
            "description": "Site-scoped Alarm feed ordered by first trigger time DESC and alarmId DESC.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CursorAlarmListResponse" } } }
          },
          "400": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/v1/alarms/{alarmId}": {
      "get": {
        "operationId": "getAlarm",
        "x-owner": "alarm-service",
        "x-public-ingress": "platform-gateway",
        "x-architecture-status": "ACTIVE",
        "x-shape-status": "READY",
        "description": "Resolves alarmId to the authoritative Alarm record before Site authorization. Missing, cross-Tenant and out-of-Site-scope resources all return 404 ALARM_NOT_FOUND to prevent BOLA disclosure.",
        "parameters": [{ "$ref": "#/components/parameters/AlarmId" }],
        "responses": {
          "200": {
            "description": "Canonical Alarm resource in the success envelope.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AlarmEnvelope" } } }
          },
          "400": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/v1/alarms/{alarmId}/ack": {
      "post": {
        "operationId": "ackAlarm",
        "x-owner": "alarm-service",
        "x-public-ingress": "platform-gateway",
        "x-architecture-status": "ACTIVE",
        "x-shape-status": "READY",
        "description": "Acknowledges that the Alarm is known. ACK does not resolve, close or otherwise change the Alarm lifecycle state. The operation is naturally idempotent; Idempotency-Key is optional.",
        "parameters": [
          { "$ref": "#/components/parameters/AlarmId" },
          { "$ref": "#/components/parameters/OptionalIdempotencyKey" }
        ],
        "requestBody": {
          "required": false,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AckAlarmRequest" } } }
        },
        "responses": {
          "200": {
            "description": "Current canonical Alarm resource. Repeated ACK returns the current Alarm without replacing the first acknowledgement fact.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AlarmEnvelope" } } }
          },
          "400": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" },
          "409": { "$ref": "#/components/responses/Error" },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "AlarmId": {
        "name": "alarmId",
        "in": "path",
        "required": true,
        "schema": { "$ref": "#/components/schemas/UUIDv7" }
      },
      "SiteIdRequired": {
        "name": "siteId",
        "in": "query",
        "required": true,
        "schema": { "$ref": "#/components/schemas/UUIDv7" }
      },
      "Limit": {
        "name": "limit",
        "in": "query",
        "required": false,
        "schema": { "type": "integer", "minimum": 1, "maximum": 200, "default": 50 }
      },
      "Cursor": {
        "name": "cursor",
        "in": "query",
        "required": false,
        "description": "Opaque cursor bound to the original Site and Alarm filters.",
        "schema": { "type": "string", "maxLength": 4096 }
      },
      "AlarmSeverity": {
        "name": "severity",
        "in": "query",
        "required": false,
        "schema": { "type": "string", "enum": ["INFO", "WARNING", "MAJOR", "CRITICAL"] }
      },
      "AlarmStatus": {
        "name": "status",
        "in": "query",
        "required": false,
        "schema": { "type": "string", "enum": ["OPEN", "ACKNOWLEDGED", "SUPPRESSED", "CLOSED"] }
      },
      "OptionalIdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": false,
        "schema": { "type": "string", "minLength": 8, "maxLength": 128 }
      }
    },
    "responses": {
      "Error": {
        "description": "SE-API-001 error envelope.",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } }
      }
    },
    "schemas": {
      "UUIDv7": {
        "type": "string",
        "format": "uuid",
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
      },
      "Meta": {
        "type": "object",
        "additionalProperties": true,
        "required": ["requestId"],
        "properties": { "requestId": { "type": "string", "minLength": 1 } }
      },
      "Alarm": {
        "type": "object",
        "additionalProperties": true,
        "required": ["alarmId", "tenantId", "siteId", "severity", "status"],
        "properties": {
          "alarmId": { "$ref": "#/components/schemas/UUIDv7" },
          "tenantId": { "$ref": "#/components/schemas/UUIDv7" },
          "siteId": { "$ref": "#/components/schemas/UUIDv7" },
          "severity": { "type": "string" },
          "status": { "type": "string" }
        }
      },
      "AlarmEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "required": ["data", "meta"],
        "properties": {
          "data": { "$ref": "#/components/schemas/Alarm" },
          "meta": { "$ref": "#/components/schemas/Meta" }
        }
      },
      "AckAlarmRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "comment": { "type": "string", "maxLength": 1000 }
        }
      },
      "CursorMeta": {
        "allOf": [
          { "$ref": "#/components/schemas/Meta" },
          {
            "type": "object",
            "required": ["limit", "hasMore"],
            "properties": {
              "limit": { "type": "integer", "minimum": 1, "maximum": 200 },
              "nextCursor": { "type": ["string", "null"] },
              "hasMore": { "type": "boolean" }
            }
          }
        ]
      },
      "CursorAlarmListResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["data", "meta"],
        "properties": {
          "data": { "type": "array", "items": { "$ref": "#/components/schemas/Alarm" } },
          "meta": { "$ref": "#/components/schemas/CursorMeta" }
        }
      },
      "ErrorEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "required": ["error", "meta"],
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "message", "details"],
            "properties": {
              "code": { "type": "string", "minLength": 1 },
              "message": { "type": "string", "minLength": 1 },
              "details": {}
            }
          },
          "meta": { "$ref": "#/components/schemas/Meta" }
        }
      }
    }
  }
}
