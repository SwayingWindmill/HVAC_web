{
  "openapi": "3.1.0",
  "info": {
    "title": "S4 Alarm Public API — SE-API-001 subordinate contract",
    "version": "2.1.2",
    "description": "Alarm Domain subordinate public contract. Public URI authority is SE-API-001 in platform-gateway.openapi.yaml. Only V2.1.2 CONTRACTED Alarm routes are represented here; request/query/domain shapes remain TO_SYNC where the full SE-API-001 source has not been supplied."
  },
  "x-authority": "SE-API-001",
  "paths": {
    "/api/v1/alarms": {
      "get": {
        "operationId": "listAlarms",
        "x-owner": "alarm-service",
        "x-public-ingress": "platform-gateway",
        "x-architecture-status": "CONTRACTED",
        "x-shape-status": "TO_SYNC_TO_SE_API_001",
        "responses": {
          "200": {
            "description": "Alarm list in the SE-API-001 success envelope.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AlarmListEnvelope" } } }
          },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/v1/alarms/{alarmId}": {
      "get": {
        "operationId": "getAlarm",
        "x-owner": "alarm-service",
        "x-public-ingress": "platform-gateway",
        "x-architecture-status": "CONTRACTED",
        "x-shape-status": "TO_SYNC_TO_SE_API_001",
        "parameters": [{ "$ref": "#/components/parameters/AlarmId" }],
        "responses": {
          "200": {
            "description": "Alarm detail in the SE-API-001 success envelope.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AlarmEnvelope" } } }
          },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/v1/alarms/{alarmId}/ack": {
      "post": {
        "operationId": "ackAlarm",
        "x-owner": "alarm-service",
        "x-public-ingress": "platform-gateway",
        "x-architecture-status": "CONTRACTED",
        "x-shape-status": "TO_SYNC_TO_SE_API_001",
        "parameters": [{ "$ref": "#/components/parameters/AlarmId" }],
        "requestBody": {
          "required": false,
          "description": "Exact ACK body and idempotency semantics are owned by the full SE-API-001 contract and remain TO_SYNC in this repository mirror.",
          "content": { "application/json": { "schema": {} } }
        },
        "responses": {
          "200": {
            "description": "Acknowledged Alarm in the SE-API-001 success envelope.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AlarmEnvelope" } } }
          },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "AlarmId": {
        "name": "alarmId",
        "in": "path",
        "required": true,
        "schema": { "$ref": "#/components/schemas/UUIDv7" }
      }
    },
    "responses": {
      "Error": {
        "description": "SE-API-001 error envelope.",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } }
      }
    },
    "schemas": {
      "UUIDv7": {
        "type": "string",
        "format": "uuid",
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
      },
      "Meta": {
        "type": "object",
        "additionalProperties": true,
        "required": ["requestId"],
        "properties": { "requestId": { "type": "string", "minLength": 1 } }
      },
      "Alarm": {
        "type": "object",
        "additionalProperties": true,
        "required": ["alarmId", "tenantId", "siteId", "severity", "status"],
        "properties": {
          "alarmId": { "$ref": "#/components/schemas/UUIDv7" },
          "tenantId": { "$ref": "#/components/schemas/UUIDv7" },
          "siteId": { "$ref": "#/components/schemas/UUIDv7" },
          "severity": { "type": "string" },
          "status": { "type": "string" }
        }
      },
      "AlarmEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "required": ["data", "meta"],
        "properties": {
          "data": { "$ref": "#/components/schemas/Alarm" },
          "meta": { "$ref": "#/components/schemas/Meta" }
        }
      },
      "AlarmListEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "required": ["data", "meta"],
        "properties": {
          "data": { "type": "array", "items": { "$ref": "#/components/schemas/Alarm" } },
          "meta": { "$ref": "#/components/schemas/Meta" }
        }
      },
      "ErrorEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "required": ["error", "meta"],
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "message", "details"],
            "properties": {
              "code": { "type": "string", "minLength": 1 },
              "message": { "type": "string", "minLength": 1 },
              "details": {}
            }
          },
          "meta": { "$ref": "#/components/schemas/Meta" }
        }
      }
    }
  }
}
