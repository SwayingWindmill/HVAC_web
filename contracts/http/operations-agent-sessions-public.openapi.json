{
  "openapi": "3.1.0",
  "info": {
    "title": "HVAC Operations Agent Sessions Public API",
    "version": "1.0.0",
    "description": "Direct Site-scoped Agent Session API. Durable snapshots are authoritative; live SSE uses hvac.agent.event/v1 and never exposes provider state or hidden reasoning."
  },
  "paths": {
    "/api/v1/sites/{siteId}/operations/agent-sessions": {
      "get": { "operationId": "listAgentSessions", "responses": { "200": { "description": "Site Agent Sessions", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AgentSessionList" } } } } } },
      "post": { "operationId": "createAgentSession", "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AgentSessionMessageRequest" } } } }, "responses": { "201": { "description": "Created Session", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AgentSessionSnapshot" } } } } } }
    },
    "/api/v1/sites/{siteId}/operations/agent-sessions/{sessionId}": {
      "get": { "operationId": "getAgentSession", "responses": { "200": { "description": "Authoritative durable snapshot", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AgentSessionSnapshot" } } } } } }
    },
    "/api/v1/sites/{siteId}/operations/agent-sessions/{sessionId}/events": {
      "get": { "operationId": "streamAgentSessionEvents", "responses": { "200": { "description": "Direct hvac.agent.event/v1 SSE, beginning with session.snapshot", "content": { "text/event-stream": { "schema": { "type": "string" } } } } } }
    },
    "/api/v1/sites/{siteId}/operations/agent-sessions/{sessionId}:run": {
      "post": { "operationId": "startAgentSessionRun", "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AgentSessionRunRequest" } } } }, "responses": { "202": { "description": "Run accepted", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AgentSessionSnapshot" } } } } } }
    },
    "/api/v1/sites/{siteId}/operations/agent-sessions/{sessionId}:cancel": {
      "post": { "operationId": "cancelAgentSession", "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AgentSessionRevisionRequest" } } } }, "responses": { "200": { "description": "Cancelled Session", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AgentSessionSnapshot" } } } } } }
    },
    "/api/v1/sites/{siteId}/operations/agent-sessions/{sessionId}:submit-input": {
      "post": { "operationId": "submitAgentSessionInput", "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AgentSessionInputRequest" } } } }, "responses": { "202": { "description": "Input committed and continuation Run accepted", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AgentSessionSnapshot" } } } } } }
    }
  },
  "components": {
    "schemas": {
      "AgentSessionMessageRequest": {
        "type": "object", "additionalProperties": false, "required": ["message"],
        "properties": { "message": { "type": "string", "minLength": 1, "maxLength": 4000 } }
      },
      "AgentSessionRunRequest": {
        "type": "object", "additionalProperties": false, "required": ["expectedRevision", "message"],
        "properties": { "expectedRevision": { "type": "integer", "minimum": 0 }, "message": { "type": "string", "minLength": 1, "maxLength": 4000 } }
      },
      "AgentSessionRevisionRequest": {
        "type": "object", "additionalProperties": false, "required": ["expectedRevision"],
        "properties": { "expectedRevision": { "type": "integer", "minimum": 0 } }
      },
      "AgentSessionInputRequest": {
        "type": "object", "additionalProperties": false, "required": ["expectedRevision", "requestArtifactId", "value"],
        "properties": {
          "expectedRevision": { "type": "integer", "minimum": 0 },
          "requestArtifactId": { "type": "string", "minLength": 1, "maxLength": 256 },
          "value": { "type": "string", "minLength": 1, "maxLength": 4000 }
        }
      },
      "AgentSessionSnapshot": {
        "type": "object", "additionalProperties": false,
        "required": ["session", "runs", "messages", "toolExecutions", "artifacts"],
        "properties": {
          "session": { "$ref": "#/components/schemas/AgentSession" },
          "runs": { "type": "array", "maxItems": 64, "items": { "$ref": "#/components/schemas/AgentRun" } },
          "messages": { "type": "array", "maxItems": 256, "items": { "$ref": "#/components/schemas/AgentMessage" } },
          "toolExecutions": { "type": "array", "maxItems": 256, "items": { "$ref": "#/components/schemas/AgentToolExecution" } },
          "artifacts": { "type": "array", "maxItems": 256, "items": { "$ref": "#/components/schemas/AgentArtifact" } }
        }
      },
      "AgentSessionList": { "type": "array", "maxItems": 50, "items": { "$ref": "#/components/schemas/AgentSessionSnapshot" } },
      "AgentSession": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "tenantId", "siteId", "agentDefinitionId", "createdBy", "revision", "createdAt", "updatedAt", "status", "activeRunId"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 256 }, "tenantId": { "type": "string", "minLength": 1, "maxLength": 256 }, "siteId": { "type": "string", "minLength": 1, "maxLength": 256 }, "agentDefinitionId": { "type": "string", "minLength": 1, "maxLength": 256 }, "createdBy": { "type": "string", "minLength": 1, "maxLength": 256 },
          "revision": { "type": "integer", "minimum": 0 }, "createdAt": { "type": "integer", "minimum": 0 }, "updatedAt": { "type": "integer", "minimum": 0 },
          "status": { "type": "string", "enum": ["ACTIVE", "WAITING_FOR_INPUT", "COMPLETED", "FAILED", "CANCELLED"] },
          "activeRunId": { "type": ["string", "null"], "maxLength": 256 }
        }
      },
      "AgentModelRef": {
        "type": "object", "additionalProperties": false, "required": ["provider", "model"],
        "properties": {
          "provider": { "type": "string", "minLength": 1, "maxLength": 256 },
          "model": { "type": "string", "minLength": 1, "maxLength": 256 }
        }
      },
      "AgentRunUsage": {
        "type": "object", "additionalProperties": false, "required": ["inputTokens", "outputTokens", "modelCalls", "toolCalls"],
        "properties": {
          "inputTokens": { "type": "integer", "minimum": 0 }, "outputTokens": { "type": "integer", "minimum": 0 },
          "modelCalls": { "type": "integer", "minimum": 0 }, "toolCalls": { "type": "integer", "minimum": 0 }
        }
      },
      "AgentRun": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "sessionId", "modelRef", "status", "startedAt", "finishedAt", "usage", "failureCode"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 256 }, "sessionId": { "type": "string", "minLength": 1, "maxLength": 256 },
          "modelRef": { "$ref": "#/components/schemas/AgentModelRef" },
          "status": { "type": "string", "enum": ["RUNNING", "COMPLETED", "FAILED", "CANCELLED"] },
          "startedAt": { "type": "integer", "minimum": 0 }, "finishedAt": { "type": ["integer", "null"], "minimum": 0 },
          "usage": { "$ref": "#/components/schemas/AgentRunUsage" }, "failureCode": { "type": ["string", "null"], "maxLength": 256 }
        }
      },
      "AgentMessage": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "sessionId", "runId", "role", "content", "createdAt"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 256 }, "sessionId": { "type": "string", "minLength": 1, "maxLength": 256 },
          "runId": { "type": ["string", "null"], "maxLength": 256 }, "role": { "type": "string", "enum": ["OPERATOR", "ASSISTANT"] },
          "content": { "type": "string", "minLength": 1, "maxLength": 4000 }, "createdAt": { "type": "integer", "minimum": 0 }
        }
      },
      "AgentEvidenceRef": {
        "type": "object", "additionalProperties": false, "required": ["owner", "resourceType", "resourceId", "toolExecutionId"],
        "properties": {
          "owner": { "type": "string", "enum": ["REGISTRY", "TELEMETRY", "ENERGY", "ALARM", "FDD", "WORK_ORDER", "COMMAND"] },
          "resourceType": { "type": "string", "minLength": 1, "maxLength": 256 }, "resourceId": { "type": "string", "minLength": 1, "maxLength": 256 },
          "revision": { "type": "string", "minLength": 1, "maxLength": 256 }, "toolExecutionId": { "type": "string", "minLength": 1, "maxLength": 256 }
        }
      },
      "AgentToolExecution": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "sessionId", "runId", "toolName", "argumentsDigest", "status", "startedAt", "finishedAt", "resultSummary", "provenance", "failureCode"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 256 }, "sessionId": { "type": "string", "minLength": 1, "maxLength": 256 }, "runId": { "type": "string", "minLength": 1, "maxLength": 256 },
          "toolName": { "type": "string", "minLength": 1, "maxLength": 512 }, "argumentsDigest": { "type": "string", "minLength": 1, "maxLength": 512 },
          "status": { "type": "string", "enum": ["RUNNING", "COMPLETED", "FAILED", "CANCELLED"] },
          "startedAt": { "type": "integer", "minimum": 0 }, "finishedAt": { "type": ["integer", "null"], "minimum": 0 },
          "resultSummary": { "type": ["string", "null"], "maxLength": 4000 },
          "provenance": { "type": "array", "maxItems": 32, "items": { "$ref": "#/components/schemas/AgentEvidenceRef" } },
          "failureCode": { "type": ["string", "null"], "maxLength": 256 }
        }
      },
      "AgentInputChoice": {
        "type": "object", "additionalProperties": false, "required": ["value", "label"],
        "properties": { "value": { "type": "string", "minLength": 1, "maxLength": 256 }, "label": { "type": "string", "minLength": 1, "maxLength": 256 } }
      },
      "AgentInputResponseSchema": {
        "oneOf": [
          { "type": "object", "additionalProperties": false, "required": ["kind", "maxLength"], "properties": { "kind": { "const": "TEXT" }, "maxLength": { "type": "integer", "minimum": 1, "maximum": 4000 } } },
          { "type": "object", "additionalProperties": false, "required": ["kind", "choices"], "properties": { "kind": { "const": "SINGLE_SELECT" }, "choices": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "#/components/schemas/AgentInputChoice" } } } }
        ]
      },
      "InvestigationComplete": {
        "type": "object", "additionalProperties": false, "required": ["outcome", "summary", "evidenceRefs", "limitations", "recommendedNext"],
        "properties": {
          "outcome": { "type": "string", "enum": ["SUPPORTED_FINDING", "UNABLE_TO_CONCLUDE"] }, "summary": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "evidenceRefs": { "type": "array", "maxItems": 32, "items": { "$ref": "#/components/schemas/AgentEvidenceRef" } },
          "limitations": { "type": "array", "maxItems": 16, "items": { "type": "string", "minLength": 1, "maxLength": 512 } },
          "recommendedNext": { "type": "array", "maxItems": 16, "items": { "type": "string", "minLength": 1, "maxLength": 512 } }
        }
      },
      "AgentArtifact": {
        "oneOf": [
          { "$ref": "#/components/schemas/AgentEvidenceRefArtifact" }, { "$ref": "#/components/schemas/AgentFindingArtifact" },
          { "$ref": "#/components/schemas/AgentProposalArtifact" }, { "$ref": "#/components/schemas/AgentInputRequestArtifact" },
          { "$ref": "#/components/schemas/AgentInputResponseArtifact" }, { "$ref": "#/components/schemas/AgentLimitationArtifact" }
        ]
      },
      "AgentEvidenceRefArtifact": {
        "type": "object", "additionalProperties": false, "required": ["id", "sessionId", "runId", "kind", "reference", "createdAt"],
        "properties": { "id": { "type": "string", "minLength": 1, "maxLength": 256 }, "sessionId": { "type": "string", "minLength": 1, "maxLength": 256 }, "runId": { "type": "string", "minLength": 1, "maxLength": 256 }, "kind": { "const": "EVIDENCE_REF" }, "reference": { "$ref": "#/components/schemas/AgentEvidenceRef" }, "createdAt": { "type": "integer", "minimum": 0 } }
      },
      "AgentFindingArtifact": {
        "type": "object", "additionalProperties": false, "required": ["id", "sessionId", "runId", "kind", "finding", "createdAt"],
        "properties": { "id": { "type": "string", "minLength": 1, "maxLength": 256 }, "sessionId": { "type": "string", "minLength": 1, "maxLength": 256 }, "runId": { "type": "string", "minLength": 1, "maxLength": 256 }, "kind": { "const": "FINDING" }, "finding": { "$ref": "#/components/schemas/InvestigationComplete" }, "createdAt": { "type": "integer", "minimum": 0 } }
      },
      "AgentProposalArtifact": {
        "type": "object", "additionalProperties": false, "required": ["id", "sessionId", "runId", "kind", "proposalType", "summary", "createdAt"],
        "properties": { "id": { "type": "string", "minLength": 1, "maxLength": 256 }, "sessionId": { "type": "string", "minLength": 1, "maxLength": 256 }, "runId": { "type": "string", "minLength": 1, "maxLength": 256 }, "kind": { "const": "PROPOSAL" }, "proposalType": { "type": "string", "minLength": 1, "maxLength": 256 }, "summary": { "type": "string", "minLength": 1, "maxLength": 4000 }, "createdAt": { "type": "integer", "minimum": 0 } }
      },
      "AgentInputRequestArtifact": {
        "type": "object", "additionalProperties": false, "required": ["id", "sessionId", "runId", "kind", "request", "createdAt"],
        "properties": { "id": { "type": "string", "minLength": 1, "maxLength": 256 }, "sessionId": { "type": "string", "minLength": 1, "maxLength": 256 }, "runId": { "type": "string", "minLength": 1, "maxLength": 256 }, "kind": { "const": "INPUT_REQUEST" }, "request": { "type": "object", "additionalProperties": false, "required": ["prompt", "response"], "properties": { "prompt": { "type": "string", "minLength": 1, "maxLength": 4000 }, "response": { "$ref": "#/components/schemas/AgentInputResponseSchema" } } }, "createdAt": { "type": "integer", "minimum": 0 } }
      },
      "AgentInputResponseArtifact": {
        "type": "object", "additionalProperties": false, "required": ["id", "sessionId", "runId", "kind", "requestArtifactId", "value", "submittedBy", "createdAt"],
        "properties": { "id": { "type": "string", "minLength": 1, "maxLength": 256 }, "sessionId": { "type": "string", "minLength": 1, "maxLength": 256 }, "runId": { "type": "string", "minLength": 1, "maxLength": 256 }, "kind": { "const": "INPUT_RESPONSE" }, "requestArtifactId": { "type": "string", "minLength": 1, "maxLength": 256 }, "value": { "type": "string", "minLength": 1, "maxLength": 4000 }, "submittedBy": { "type": "string", "minLength": 1, "maxLength": 256 }, "createdAt": { "type": "integer", "minimum": 0 } }
      },
      "AgentLimitationArtifact": {
        "type": "object", "additionalProperties": false, "required": ["id", "sessionId", "runId", "kind", "description", "createdAt"],
        "properties": { "id": { "type": "string", "minLength": 1, "maxLength": 256 }, "sessionId": { "type": "string", "minLength": 1, "maxLength": 256 }, "runId": { "type": "string", "minLength": 1, "maxLength": 256 }, "kind": { "const": "LIMITATION" }, "description": { "type": "string", "minLength": 1, "maxLength": 4000 }, "createdAt": { "type": "integer", "minimum": 0 } }
      },
      "AgentEvent": {
        "type": "object", "additionalProperties": false,
        "required": ["version", "type", "sessionId", "runId", "sequence", "at", "payload"],
        "properties": {
          "version": { "const": "hvac.agent.event/v1" },
          "type": { "type": "string", "enum": ["session.snapshot", "run.started", "assistant.delta", "tool.started", "tool.completed", "artifact.created", "input.required", "run.completed", "run.failed"] },
          "sessionId": { "type": "string", "minLength": 1, "maxLength": 256 }, "runId": { "type": ["string", "null"], "maxLength": 256 }, "sequence": { "type": "integer", "minimum": 0 }, "at": { "type": "integer", "minimum": 0 }, "payload": { "type": "object" }
        }
      }
    }
  }
}
