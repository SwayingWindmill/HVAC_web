{
  "schemaVersion": 1,
  "decisionRevision": 4,
  "activationStatus": "v2-active",
  "ownerService": "telemetry-runtime-service",
  "boundedContext": "telemetry-runtime",
  "sourceOfTruth": "SE-DATA-001 V2.0 CURRENT",
  "storageAuthorities": {
    "operationalIngest": {
      "engine": "postgresql",
      "schema": "telemetry_runtime",
      "authority": "ingest-transaction-dedup-quarantine-outbox",
      "writer": "telemetry-runtime-service",
      "runtimeBypassRls": false
    },
    "historicalTelemetry": {
      "engine": "clickhouse",
      "database": "telemetry_history",
      "table": "observations",
      "authority": "historical-telemetry-source-of-truth",
      "writer": "telemetry-runtime-service-history-relay",
      "queryOwner": "telemetry-query-service"
    },
    "latestTelemetry": {
      "engine": "redis",
      "authority": "rebuildable-latest-cache",
      "writer": "telemetry-runtime-service",
      "readOwner": "telemetry-runtime-service",
      "implementationStatus": "PASS",
      "mustNotRegressOnOutOfOrder": true,
      "writeSemantics": "business-revision-cas",
      "materialization": "committed-device-snapshot-outbox",
      "rebuildFrom": "postgresql-business-state-machine-snapshot",
      "historicalFactAuthority": "clickhouse-historical-telemetry"
    },
    "postgresLatestProjection": {
      "engine": "postgresql",
      "schema": "telemetry_runtime",
      "table": "latest_accepted_telemetry",
      "authority": "internal-ingest-evaluator-working-projection",
      "implementationStatus": "INTERNAL_ONLY",
      "publicRead": false,
      "historicalAuthority": false,
      "mustNotBeFinalV2Authority": true
    },
    "transportHistory": {
      "engine": "dedicated-redis",
      "authority": "ephemeral-continuity-cache",
      "writer": "centrifugo",
      "sharedWithLatestCache": false
    },
    "mqtt": {
      "authority": "transport-only",
      "telemetryTopic": "energy/v1/{tenant}/{site}/{gateway}/telemetry"
    }
  },
  "ownedResources": [
    { "kind": "projection", "name": "device-runtime-binding", "writer": "telemetry-runtime-service", "sourceOwner": "platform-core-service" },
    { "kind": "projection", "name": "presence-policy", "writer": "telemetry-runtime-service" },
    { "kind": "projection", "name": "freshness-policy", "writer": "telemetry-runtime-service" },
    { "kind": "internal-working-projection", "name": "latest-accepted-telemetry", "writer": "telemetry-runtime-service", "authority": false, "publicRead": false },
    { "kind": "projection", "name": "device-presence", "writer": "telemetry-runtime-service" },
    { "kind": "projection", "name": "device-observation-snapshot", "writer": "telemetry-runtime-service" },
    { "kind": "ingest-evidence", "name": "source-observation", "writer": "telemetry-runtime-service", "historicalAuthority": false },
    { "kind": "projection", "name": "ingest-deduplication", "writer": "telemetry-runtime-service" },
    { "kind": "projection", "name": "ingest-quarantine", "writer": "telemetry-runtime-service" },
    { "kind": "outbox", "name": "telemetry-history-outbox", "writer": "telemetry-runtime-service", "relay": "telemetry-runtime-service-history-relay" },
    { "kind": "outbox", "name": "telemetry-publication-outbox", "writer": "telemetry-runtime-service", "relay": "outbox-relay" },
    { "kind": "event-family", "name": "hvac.telemetry.device-snapshot.v1", "writer": "telemetry-runtime-service" }
  ],
  "ingestSources": [
    {
      "service": "mqtt-telemetry-adapter",
      "transport": "MQTT",
      "schema": "energy-telemetry-envelope/v1",
      "unknownMajorVersion": "REJECT"
    }
  ],
  "positions": {
    "sourcePosition": {
      "owner": "source-adapter",
      "purpose": "deduplication-and-replay-evidence",
      "examples": ["source partition plus source offset", "source event id"]
    },
    "businessRevision": {
      "owner": "telemetry-runtime-service",
      "scope": "device-current-snapshot",
      "doesNotAdvanceFor": ["duplicate source delivery", "rejected candidate", "out-of-order historical fact", "publication retry", "cache refresh"]
    },
    "transportPosition": {
      "owner": "centrifugo",
      "purpose": "bounded-reconnect-recovery",
      "authority": "none"
    },
    "recoveryCursor": {
      "owner": "telemetry-runtime-service",
      "authority": "none",
      "reuseRequires": ["current authorization", "exact route and scope match"]
    }
  },
  "telemetrySemantics": {
    "canonicalPoint": true,
    "eventTimeField": "sampled_at",
    "ingestTimeField": "received_at",
    "outOfOrder": {
      "history": "INSERT_FULL_FACT",
      "latest": "NO_UPDATE"
    },
    "quality": ["GOOD", "PARTIAL", "ESTIMATED", "MANUAL", "STALE", "INVALID"],
    "qualityIndependentFromAcceptance": true,
    "unknownPoint": "QUARANTINE"
  },
  "serviceResponsibilities": [
    {
      "service": "platform-core-service",
      "owns": ["Device identity", "Point identity", "external source bindings"],
      "mustNot": ["write latest telemetry", "write historical telemetry facts"]
    },
    {
      "service": "mqtt-telemetry-adapter",
      "owns": ["MQTT envelope decoding", "schema-version rejection", "source position mapping"],
      "mustNot": ["own Device or Point identity", "write Latest directly", "write browser state"]
    },
    {
      "service": "telemetry-runtime-service",
      "owns": ["ingest validation", "deduplication", "quarantine", "historical relay intent", "Latest projection update decision", "Presence", "Freshness", "Business Revision"],
      "mustNot": ["create Registry Device or Point identity", "overwrite Historical facts", "regress Latest on out-of-order"]
    },
    {
      "service": "telemetry-query-service",
      "owns": ["bounded historical telemetry API", "bounded analytics API"],
      "mustNot": ["serve historical data from PostgreSQL operational ingest evidence", "expose ClickHouse directly to browser"]
    },
    {
      "service": "centrifugo",
      "owns": ["client realtime fan-out", "bounded transport recovery"],
      "mustNot": ["own historical telemetry", "own Latest authority", "authorize from transport history"]
    }
  ],
  "ingestTransaction": [
    "authenticate source adapter and validate integration instance",
    "resolve one active Device and Point binding",
    "quarantine unknown or conflicting mapping without creating identity",
    "deduplicate by source position",
    "validate type unit range event time and source quality",
    "persist operational ingest evidence and a historical outbox intent",
    "preserve valid out-of-order values for ClickHouse history while refusing Latest regression",
    "publish historical fact to ClickHouse and current/realtime projections after commit"
  ],
  "historicalTimeseries": {
    "insideS2Slice": true,
    "authority": "clickhouse.telemetry_history.observations",
    "publicOwner": "telemetry-query-service",
    "postgresOperationalEvidenceIsAuthority": false
  },
  "currentState": {
    "v2Authority": "redis-rebuildable-latest-cache",
    "implementationStatus": "PARTIAL",
    "temporaryPostgresProjectionExists": true,
    "migrationBlocker": "Redis Latest writer/read path and rebuild contract are not yet complete"
  },
  "forbiddenFlows": [
    "browser-to-mqtt",
    "mqtt-direct-to-latest-without-ingest-validation",
    "postgres-operational-ingest-evidence-as-historical-authority",
    "out-of-order-to-latest-regression",
    "transport-history-to-latest-authority",
    "browser-direct-to-clickhouse",
    "shadow-or-fallback-path-with-side-effects"
  ]
}
