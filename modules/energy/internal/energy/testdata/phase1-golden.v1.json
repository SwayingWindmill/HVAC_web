      "expectFact": true,
      "expectedEnergyKWh": 1.25,
      "expectedQuality": "SUSPECT",
      "expectedQualityReasons": ["SOURCE_LAG_EXCEEDED"]
    },
    {
      "name": "counter reset uses canonical delta",
      "transitionType": "RESET",
      "deltaValueKWh": 4.5,
      "currentQuality": "GOOD",
      "currentQualityReasons": [],
      "expectFact": true,
      "expectedEnergyKWh": 4.5,
      "expectedQuality": "VALID",
      "expectedQualityReasons": []
    },
    {
      "name": "invalid decrease is excluded",
      "transitionType": "INVALID_DECREASE",
      "currentQuality": "GOOD",
      "currentQualityReasons": [],
      "expectFact": false
    }
