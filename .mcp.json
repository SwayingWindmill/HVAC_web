{
  "mcpServers": {
    "codegraph": {
      "type": "stdio",
      "command": "node",
      "args": [
        "./node_modules/@colbymchenry/codegraph/npm-shim.js",
        "serve",
        "--mcp"
      ],
      "env": {
        "CODEGRAPH_TELEMETRY": "0"
      }
    },
    "reui": {
      "type": "http",
      "url": "https://mcp.reui.io/api/mcp"
    }
  }
}
