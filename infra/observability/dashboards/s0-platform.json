{
  "title": "S0 Platform Observability",
  "uid": "s0-platform",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "HTTP traffic by service and route",
      "type": "timeseries",
      "targets": [{ "expr": "sum by (service, route) (rate(s0_http_requests_total[5m]))", "legendFormat": "{{service}} {{route}}" }]
    },
    {
      "id": 2,
      "title": "HTTP error rate",
      "type": "timeseries",
      "targets": [{ "expr": "sum by (service, route) (rate(s0_http_requests_total{result=\"error\"}[5m]))", "legendFormat": "{{service}} {{route}}" }]
    },
    {
      "id": 3,
      "title": "HTTP p95 latency",
      "type": "timeseries",
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (le, service, route) (rate(s0_http_request_duration_seconds_bucket[5m])))", "legendFormat": "{{service}} {{route}}" }]
    },
    {
      "id": 8,
      "title": "Telemetry pressure",
      "type": "timeseries",
      "targets": [
        { "expr": "s0_telemetry_dropped_spans", "legendFormat": "dropped {{service}}" },
        { "expr": "s0_telemetry_failed_exports", "legendFormat": "failed {{service}}" }
      ]
    },
    {
      "id": 9,
      "title": "Public API failures",
      "type": "timeseries",
      "targets": [{ "expr": "sum by (route) (rate(s0_http_requests_total{service=\"platform-gateway\",result=\"error\"}[5m]))", "legendFormat": "{{route}}" }]
    },
    {
      "id": 10,
      "title": "Internal identity failures",
      "type": "timeseries",
      "targets": [{ "expr": "sum by (route) (rate(s0_http_requests_total{service=\"iam-service\",result=\"error\"}[5m]))", "legendFormat": "{{route}}" }]
    }
  ]
}
