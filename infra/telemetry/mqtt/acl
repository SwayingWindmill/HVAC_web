# Mosquitto uses each client certificate's CN as its username (use_identity_as_username).
# A Gateway's CN is its Registry Device id, so these patterns confine every Gateway to
# its own topics and adding a Gateway changes nothing here (ADR 0015).
pattern write hvac/v1/%u/up/#
pattern read hvac/v1/%u/down/#

# Connectivity consumes Gateway uplinks (excluding command replies), subscribes to
# Mosquitto connection notices, and sends concentrator RPC and shadow replication messages.
user mqtt-telemetry-adapter
topic read hvac/v1/+/up/telemetry
topic read hvac/v1/+/up/event
topic read hvac/v1/+/up/status
topic read hvac/v1/+/up/concentrator
topic read hvac/v1/+/up/shadow
topic read hvac/v1/+/up/ota
topic read $SYS/broker/log/N
topic write hvac/v1/+/down/concentrator
topic write hvac/v1/+/down/shadow
topic write hvac/v1/+/down/ota
topic write $CONTROL/hvac-crl/v1

# Connectivity's command connection sends to every Gateway and reads every reply.
user command-dispatcher
topic write hvac/v1/+/down/command
topic read hvac/v1/+/up/reply
