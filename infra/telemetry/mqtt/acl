# Mosquitto uses each client certificate's CN as its username (use_identity_as_username).
# A Gateway's CN is its Registry Device id, so these patterns confine every Gateway to
# its own topics and adding a Gateway changes nothing here (ADR 0015).
pattern write hvac/v1/%u/up/#
pattern read hvac/v1/%u/down/#

# Connectivity consumes every Gateway's uplink.
user mqtt-telemetry-adapter
topic read hvac/v1/+/up/#

# Connectivity's command connection sends to every Gateway and reads every reply.
user command-dispatcher
topic write hvac/v1/+/down/command
topic read hvac/v1/+/up/reply
