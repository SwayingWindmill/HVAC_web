{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/*": ["apps/hvac-web/src/*"]
    },
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "types": ["vite/client", "node", "react", "react-dom"]
  },
  "include": [
    "scripts/**/*.ts",
    "scripts/**/*.d.ts",
    "scripts/**/*.d.mts",
    "apps/hvac-web/src/**/*.d.ts",
    "apps/hvac-web/src/app/router.ts",
    "apps/hvac-web/src/app/router-context.ts"
  ]
}
