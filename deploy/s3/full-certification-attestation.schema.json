{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hvac.local/schemas/s3/full-certification-attestation.v1.json",
  "title": "S3 full Command certification attestation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "repositorySha",
    "workflowRunId",
    "environment",
    "load",
    "observed",
    "zeroCounters",
    "crashPoints",
    "canary",
    "rollback",
    "approval"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "repositorySha": { "type": "string", "minLength": 7 },
    "workflowRunId": { "type": "string", "minLength": 1 },
    "environment": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": true
    },
    "load": {
      "type": "object",
      "additionalProperties": false,
      "required": ["steadyCommandsPerSecond", "steadyDurationSeconds", "burstCommandsPerSecond", "burstDurationSeconds"],
      "properties": {
        "steadyCommandsPerSecond": { "type": "number", "minimum": 0 },
        "steadyDurationSeconds": { "type": "number", "minimum": 0 },
        "burstCommandsPerSecond": { "type": "number", "minimum": 0 },
        "burstDurationSeconds": { "type": "number", "minimum": 0 }
      }
    },
    "observed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "acceptedToSubmittedP95Milliseconds",
        "acceptedToSubmittedP99Milliseconds",
        "governanceP95Milliseconds",
        "governanceP99Milliseconds",
        "queuedReadyToSendStartedP95Milliseconds",
        "queuedReadyToSendStartedP99Milliseconds",
        "statusPropagationP95Milliseconds",
        "statusPropagationP99Milliseconds",
        "cpuPeakFraction",
        "memoryPeakFraction",
        "postgresPoolPeakFraction",
        "networkPeakFraction",
        "minimumHeadroomFraction"
      ],
      "properties": {
        "acceptedToSubmittedP95Milliseconds": { "type": "number", "minimum": 0 },
        "acceptedToSubmittedP99Milliseconds": { "type": "number", "minimum": 0 },
        "governanceP95Milliseconds": { "type": "number", "minimum": 0 },
        "governanceP99Milliseconds": { "type": "number", "minimum": 0 },
        "queuedReadyToSendStartedP95Milliseconds": { "type": "number", "minimum": 0 },
        "queuedReadyToSendStartedP99Milliseconds": { "type": "number", "minimum": 0 },
        "statusPropagationP95Milliseconds": { "type": "number", "minimum": 0 },
        "statusPropagationP99Milliseconds": { "type": "number", "minimum": 0 },
        "cpuPeakFraction": { "type": "number", "minimum": 0, "maximum": 1 },
        "memoryPeakFraction": { "type": "number", "minimum": 0, "maximum": 1 },
        "postgresPoolPeakFraction": { "type": "number", "minimum": 0, "maximum": 1 },
        "networkPeakFraction": { "type": "number", "minimum": 0, "maximum": 1 },
        "minimumHeadroomFraction": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "zeroCounters": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "crashPoints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "passed", "evidence"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "passed": { "const": true },
          "evidence": { "type": "string", "minLength": 1 },
          "recoverySeconds": { "type": "number", "minimum": 0 }
        }
      }
    },
    "canary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "organizationCount",
        "siteCount",
        "deviceCount",
        "organizationId",
        "siteId",
        "deviceId",
        "capability",
        "capabilityRevision",
        "risk",
        "mappingStatus",
        "providerContract",
        "maximumObservedSetpointDeltaC",
        "s2CurrentStateProductionCertified",
        "publicRoutesEnabled",
        "productionTrafficPercent",
        "startedAt",
        "endedAt",
        "holdMinutes",
        "commandCount",
        "verifiedCommandCount",
        "outcomeUnknownCount",
        "automaticReissuesAfterRequestCommitted",
        "operatorConfirmedEachCommand",
        "credentialReference"
      ],
      "properties": {
        "phase": { "type": "string" },
        "organizationCount": { "type": "integer", "minimum": 1 },
        "siteCount": { "type": "integer", "minimum": 1 },
        "deviceCount": { "type": "integer", "minimum": 1 },
        "organizationId": { "type": "string", "minLength": 1 },
        "siteId": { "type": "string", "minLength": 1 },
        "deviceId": { "type": "string", "minLength": 1 },
        "capability": { "type": "string" },
        "capabilityRevision": { "type": "string" },
        "risk": { "type": "string" },
        "mappingStatus": { "type": "string" },
        "providerContract": { "type": "string" },
        "maximumObservedSetpointDeltaC": { "type": "number", "minimum": 0 },
        "s2CurrentStateProductionCertified": { "type": "boolean" },
        "publicRoutesEnabled": { "type": "boolean" },
        "productionTrafficPercent": { "type": "number" },
        "startedAt": { "type": "string", "format": "date-time" },
        "endedAt": { "type": "string", "format": "date-time" },
        "holdMinutes": { "type": "number", "minimum": 0 },
        "commandCount": { "type": "integer", "minimum": 0 },
        "verifiedCommandCount": { "type": "integer", "minimum": 0 },
        "outcomeUnknownCount": { "type": "integer", "minimum": 0 },
        "automaticReissuesAfterRequestCommitted": { "type": "integer", "minimum": 0 },
        "operatorConfirmedEachCommand": { "type": "boolean" },
        "credentialReference": { "type": "string", "minLength": 1 }
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "futureCommandsOnly", "acceptedCommandsRemainWithOriginalOwner", "connectorCredentialDisabledMinutes"],
      "properties": {
        "passed": { "const": true },
        "futureCommandsOnly": { "type": "boolean" },
        "acceptedCommandsRemainWithOriginalOwner": { "type": "boolean" },
        "connectorCredentialDisabledMinutes": { "type": "number", "minimum": 0 }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manual", "approvedAt", "primaryOwner", "secondaryOwner", "statement"],
      "properties": {
        "manual": { "const": true },
        "approvedAt": { "type": "string", "format": "date-time" },
        "primaryOwner": { "type": "string", "minLength": 1 },
        "secondaryOwner": { "type": "string", "minLength": 1 },
        "statement": { "type": "string", "minLength": 1 }
      }
    }
  }
}
