# Production-shaped staging contract. Secrets are supplied by the cluster Secret store.
S0_ENV=staging
S0_CONFIG_REVISION=1
S0_TRUST_DOMAIN=hvac.staging.local
OIDC_ISSUER=https://idp.staging.local
OIDC_CLIENT_ID=hvac-web-s0-staging
IAM_AUDIENCE=iam-service
AUDIT_AUDIENCE=audit-ledger-service
CONTROL_BACKBONE_BROKERS=redpanda.s0-staging.svc.cluster.local:9092
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector.s0-staging.svc.cluster.local:4318
POSTGRES_ENDPOINT=postgres.s0-staging.svc.cluster.local:5432
ALLOW_PRODUCTION_EGRESS=false
THINGSBOARD_BASE_URL=
WEBHOOK_BASE_URL=
