{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hvac.local/schemas/s0-staging-bindings.json",
  "title": "S0 staging private render bindings",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "SIGNED_IMAGE_PLATFORM_GATEWAY": { "$ref": "#/$defs/image" },
    "SIGNED_IMAGE_IAM_SERVICE": { "$ref": "#/$defs/image" },
    "SIGNED_IMAGE_AUDIT_LEDGER_SERVICE": { "$ref": "#/$defs/image" },
    "SIGNED_IMAGE_OUTBOX_RELAY": { "$ref": "#/$defs/image" },
    "SIGNED_IMAGE_OIDC_TEST_PROVIDER": { "$ref": "#/$defs/image" },
    "SIGNED_IMAGE_LEGACY_PRIVATE": { "$ref": "#/$defs/image" },
    "SIGNED_IMAGE_S0_MIGRATOR": { "$ref": "#/$defs/image" },
    "GATEWAY_DATABASE_URL": { "type": "string", "minLength": 1 },
    "SESSION_TOKEN_KEY": { "type": "string", "minLength": 1 },
    "AUDIT_CONSUMER_DATABASE_URL": { "type": "string", "minLength": 1 },
    "AUDIT_QUERY_DATABASE_URL": { "type": "string", "minLength": 1 },
    "OUTBOX_DATABASE_URL": { "type": "string", "minLength": 1 },
    "MIGRATOR_DATABASE_PASSWORD": { "type": "string", "minLength": 1 },
    "POSTGRES_HOST": { "type": "string", "pattern": "^[A-Za-z0-9.-]+$" },
    "WORKLOAD_CERT_PATH": { "$ref": "#/$defs/absolutePath" },
    "WORKLOAD_KEY_PATH": { "$ref": "#/$defs/absolutePath" },
    "TRUST_BUNDLE_PATH": { "$ref": "#/$defs/absolutePath" },
    "RUNTIME_BINDINGS_IAM_SERVICE": { "type": "array" },
    "RUNTIME_BINDINGS_AUDIT_LEDGER_SERVICE": { "type": "array" },
    "RUNTIME_BINDINGS_OUTBOX_RELAY": { "type": "array" },
    "RUNTIME_BINDINGS_OIDC_TEST_PROVIDER": { "type": "array" },
    "RUNTIME_BINDINGS_LEGACY_PRIVATE": { "type": "array" },
    "RUNTIME_IDENTITY_MOUNTS": { "type": "array" },
    "RUNTIME_IDENTITY_VOLUMES": { "type": "array" },
    "RUNTIME_IDENTITY_AND_ROUTE_MOUNTS": { "type": "array" },
    "RUNTIME_IDENTITY_AND_ROUTE_VOLUMES": { "type": "array" },
    "RUNTIME_TRUST_MOUNTS": { "type": "array" },
    "RUNTIME_TRUST_VOLUMES": { "type": "array" }
  },
  "required": [
    "SIGNED_IMAGE_PLATFORM_GATEWAY",
    "SIGNED_IMAGE_IAM_SERVICE",
    "SIGNED_IMAGE_AUDIT_LEDGER_SERVICE",
    "SIGNED_IMAGE_OUTBOX_RELAY",
    "SIGNED_IMAGE_OIDC_TEST_PROVIDER",
    "SIGNED_IMAGE_LEGACY_PRIVATE",
    "SIGNED_IMAGE_S0_MIGRATOR",
    "GATEWAY_DATABASE_URL",
    "SESSION_TOKEN_KEY",
    "AUDIT_CONSUMER_DATABASE_URL",
    "AUDIT_QUERY_DATABASE_URL",
    "OUTBOX_DATABASE_URL",
    "MIGRATOR_DATABASE_PASSWORD",
    "POSTGRES_HOST",
    "WORKLOAD_CERT_PATH",
    "WORKLOAD_KEY_PATH",
    "TRUST_BUNDLE_PATH",
    "RUNTIME_BINDINGS_IAM_SERVICE",
    "RUNTIME_BINDINGS_AUDIT_LEDGER_SERVICE",
    "RUNTIME_BINDINGS_OUTBOX_RELAY",
    "RUNTIME_BINDINGS_OIDC_TEST_PROVIDER",
    "RUNTIME_BINDINGS_LEGACY_PRIVATE",
    "RUNTIME_IDENTITY_MOUNTS",
    "RUNTIME_IDENTITY_VOLUMES",
    "RUNTIME_IDENTITY_AND_ROUTE_MOUNTS",
    "RUNTIME_IDENTITY_AND_ROUTE_VOLUMES",
    "RUNTIME_TRUST_MOUNTS",
    "RUNTIME_TRUST_VOLUMES"
  ],
  "$defs": {
    "image": {
      "type": "string",
      "pattern": "^[a-z0-9./_-]+@sha256:[a-f0-9]{64}$"
    },
    "absolutePath": {
      "type": "string",
      "pattern": "^/"
    }
  }
}
