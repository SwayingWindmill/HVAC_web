{
  "schemaVersion": 1,
  "name": "智慧能源系统 Phase 1 总体与部署架构基线",
  "sourceOfTruth": "SE-ARCH-DEPLOY-001 V1.0 CURRENT",
  "phase": "phase1",
  "deploymentModel": {
    "host": "single-linux-server",
    "orchestration": "docker-compose",
    "kubernetesRequired": false,
    "singleServerRequired": true,
    "fewServersAllowed": false
  },
  "environments": [
    "development",
    "testing",
    "staging",
    "production"
  ],
  "environmentIsolation": [
    "database",
    "redis",
    "mqtt",
    "storage",
    "secrets",
    "domain",
    "configuration"
  ],
  "logicalLayers": [
    "edge",
    "central-platform",
    "data-platform",
    "monitoring-platform"
  ],
  "publicZone": {
    "owner": "nginx",
    "allowedPorts": [443, 8883],
    "allowedProtocols": ["HTTPS", "WSS", "MQTT_TLS"],
    "databasePublicExposureAllowed": false,
    "internalServicePublicExposureAllowed": false
  },
  "applicationZone": {
    "requiredCapabilities": [
      "frontend-static-hosting",
      "platform-api",
      "identity-and-authorization",
      "registry-device-management",
      "telemetry-ingest-and-current-state",
      "telemetry-history-and-query",
      "alarm",
      "control",
      "work-order",
      "application-scheduler-coordination",
      "background-workers"
    ],
    "servicePrinciple": "stateless-where-possible"
  },
  "dataZone": {
    "postgresql": "business-config-current-state-control-alarm",
    "clickhouse": "historical-telemetry-and-analytics",
    "redis": "rebuildable-cache-and-realtime-transport",
    "mqtt": "edge-cloud-transport",
    "objectStorage": "deferred-until-report-export-ota-model-or-cold-archive-requires-it"
  },
  "edgeZone": {
    "controlPlaneContract": "contracts/architecture/edge-control-plane.v1.json",
    "cloudDirectOTAccessAllowed": false,
    "path": ["cloud-control-plane", "hvac-edge-control-plane", "protocol-bridge", "device-driver", "device"],
    "hardRealtime": false,
    "hardRealtimeOwner": "plc-device-protection-safety-hardware",
    "defaultControlCycle": "1s",
    "cloudCommandSemantics": "governed-leased-intent",
    "canonicalCloudDataPoint": "point",
    "canonicalEdgeRuntimeDataObject": "channel",
    "requiredProperties": [
      "local-collection",
      "store-and-forward",
      "cloud-failure-isolation",
      "replay-after-recovery",
      "edge-component-registry",
      "capability-profile-registry",
      "channel-runtime",
      "process-image",
      "input-process-output-cycle",
      "controller-runtime",
      "scheduler-control-arbiter",
      "local-safety-interlock-controllers",
      "device-driver-abstraction",
      "protocol-bridge-abstraction",
      "edge-manifest",
      "edge-timedata",
      "leased-cloud-command-intents",
      "simulator-real-driver-parity"
    ],
    "currentConformance": "PARTIAL"
  },
  "observability": {
    "requiredSignals": ["metrics", "logs", "traces", "events", "audit"],
    "requiredOperationalViews": ["platform", "iot", "data", "control"],
    "phase1Topology": "single-instance-compose-with-profiles",
    "profiles": {
      "observability-core": [
        "prometheus",
        "node-exporter",
        "grafana"
      ],
      "observability-logs": [
        "prometheus",
        "node-exporter",
        "grafana",
        "otel-collector",
        "loki"
      ],
      "observability-full": [
        "prometheus",
        "node-exporter",
        "grafana",
        "otel-collector",
        "loki",
        "tempo"
      ]
    }
  },
  "delivery": {
    "pipeline": ["git", "ci", "test", "build", "image", "registry", "staging", "approval", "production"],
    "mutableLatestOnlyAllowed": false,
    "gitCommitTraceabilityRequired": true,
    "migrationInReleaseFlowRequired": true,
    "backwardCompatibleMigrationPreferred": false
  },
  "recovery": {
    "sourceOfTruth": "SE-OPS-009 V1.0 CURRENT CANDIDATE",
    "targetContract": "deploy/platform/phase1/recovery/recovery-targets.v1.json",
    "backupRequired": true,
    "offServerBackupCopyRequired": true,
    "restoreTestRequired": true,
    "timestampedProductionLikeDrillRequired": true,
    "rpoRtoTargetsDefined": true,
    "postgresRpoSeconds": 300,
    "postgresRtoSeconds": 7200,
    "controlRpoSeconds": 300,
    "controlRtoSeconds": 3600,
    "telemetryCloudRtoSeconds": 14400,
    "metricRpoSeconds": 1800,
    "metricRtoSeconds": 14400,
    "wholeServerReplacementRtoSeconds": 14400,
    "wholeServerFourHourTargetRequiresColdStandby": true,
    "edgeStoreAndForwardCountsTowardTelemetryRecovery": true,
    "attainmentContract": "deploy/platform/phase1/recovery/attainment.v1.json",
    "numericAvailabilitySloClaimForbiddenWithoutEvidence": true
  },
  "phase1DeferredCapabilities": [
    "kubernetes-as-primary-orchestrator",
    "service-mesh",
    "automatic-horizontal-scaling",
    "multi-region",
    "postgresql-replica-ha",
    "clickhouse-replica-ha",
    "mqtt-cluster",
    "kafka-or-redpanda-as-required-platform-backbone",
    "gitops-controller",
    "multi-node-observability-cluster"
  ],
  "deploymentTiers": {
    "contract": "deploy/platform/phase1/deployment-tiers.v1.json",
    "profiles": [
      "observability-core",
      "observability-logs",
      "observability-full",
      "local-postgres",
      "local-clickhouse",
      "local-redis",
      "integration",
      "intelligence"
    ],
    "profileSelectionRequired": true,
    "intelligenceServicesOptional": true
  },
  "runtimeInventory": {
    "contract": "deploy/platform/phase1/runtime-inventory.v1.json",
    "canonicalCompose": "deploy/platform/phase1/compose.yaml",
    "defaultBusinessDeployables": ["energy-api", "telemetry-worker", "metric-worker"],
    "defaultSupportingWorkloads": ["scheduler", "maintenance"],
    "defaultIdentityInfrastructure": ["identity-service"],
    "localStatefulInfrastructure": ["postgres", "clickhouse", "redis"],
    "optionalIntegration": ["iot-service", "mqtt-broker"],
    "optionalIntelligence": ["forecast-service", "optimization-service", "fdd-service"],
    "allComposeServicesClassified": true
  },
  "availabilityTier": {
    "contract": "deploy/platform/phase1/availability-tier.v1.json",
    "currentTier": "SINGLE_NODE_RECOVERABLE",
    "highAvailability": false,
    "numericAvailabilitySloAllowed": false
  }
}
