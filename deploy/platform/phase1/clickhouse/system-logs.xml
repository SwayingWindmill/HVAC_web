<clickhouse>
    <!-- ClickHouse's own diagnostic logs write millions of rows a day and keep merging them. On the
         single-server tiers that cost competes with telemetry ingestion for the same cores and memory;
         the platform's metrics come from Prometheus, so only query_log stays. -->
    <trace_log remove="1"/>
    <text_log remove="1"/>
    <processors_profile_log remove="1"/>
    <metric_log remove="1"/>
    <asynchronous_metric_log remove="1"/>
    <query_thread_log remove="1"/>
    <query_views_log remove="1"/>
    <part_log remove="1"/>
    <session_log remove="1"/>
    <opentelemetry_span_log remove="1"/>
    <latency_log remove="1"/>
    <error_log remove="1"/>
    <query_metric_log remove="1"/>
    <background_schedule_pool_log remove="1"/>
    <asynchronous_insert_log remove="1"/>
    <!-- query_log is what we read when a write fails (see docs/operations/alerts.md). Three days covers a
         weekend; at about 780k queries a day seven days grew it past the telemetry itself (718 MiB vs
         482 MiB on 2026-10-29). Changing this TTL makes ClickHouse rename the old table to
         system.query_log_N on the next start; drop that by hand (docs/operations/disk-full.md). -->
    <query_log>
        <ttl>event_date + INTERVAL 3 DAY DELETE</ttl>
    </query_log>
</clickhouse>
