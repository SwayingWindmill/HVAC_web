HVAC_ENV=production
PHASE1_ENV_FILE=./environments/production.runtime.env

HVAC_WEB_IMAGE=registry.example.com/hvac/hvac-web-real@sha256:[SIGNED_DIGEST]
PLATFORM_GATEWAY_IMAGE=registry.example.com/hvac/platform-gateway@sha256:[SIGNED_DIGEST]
IAM_SERVICE_IMAGE=registry.example.com/hvac/iam-service@sha256:[SIGNED_DIGEST]
PLATFORM_CORE_IMAGE=registry.example.com/hvac/platform-core-service@sha256:[SIGNED_DIGEST]
AUDIT_LEDGER_IMAGE=registry.example.com/hvac/audit-ledger-service@sha256:[SIGNED_DIGEST]
TELEMETRY_RUNTIME_IMAGE=registry.example.com/hvac/telemetry-runtime-service@sha256:[SIGNED_DIGEST]
MQTT_ADAPTER_IMAGE=registry.example.com/hvac/mqtt-telemetry-adapter@sha256:[SIGNED_DIGEST]
TELEMETRY_HISTORY_PROJECTOR_IMAGE=registry.example.com/hvac/telemetry-history-projector@sha256:[SIGNED_DIGEST]
ANALYTICS_PROJECTOR_IMAGE=registry.example.com/hvac/analytics-read-model-projector@sha256:[SIGNED_DIGEST]
TELEMETRY_QUERY_IMAGE=registry.example.com/hvac/telemetry-query-service@sha256:[SIGNED_DIGEST]
ALARM_SERVICE_IMAGE=registry.example.com/hvac/alarm-service@sha256:[SIGNED_DIGEST]
COMMAND_SERVICE_IMAGE=registry.example.com/hvac/command-service@sha256:[SIGNED_DIGEST]
COMMAND_DISPATCHER_IMAGE=registry.example.com/hvac/command-dispatcher@sha256:[SIGNED_DIGEST]
COMMAND_VERIFIER_IMAGE=registry.example.com/hvac/command-verifier@sha256:[SIGNED_DIGEST]
WORK_ORDER_SERVICE_IMAGE=registry.example.com/hvac/work-order-service@sha256:[SIGNED_DIGEST]
PHASE1_MIGRATOR_IMAGE=registry.example.com/hvac/phase1-migrator@sha256:[SIGNED_DIGEST]

PUBLIC_ORIGIN=https://app.energy.example.com
HVAC_WEB_BUILD_ID=[GIT_COMMIT]
HVAC_WEB_GATEWAY_BASE_PATH=
HVAC_WEB_REALTIME_PROTOCOL=centrifugo
ALLOW_PRODUCTION_EGRESS=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318

OIDC_ISSUER=https://id.energy.example.com
OIDC_CLIENT_ID=hvac-web-production
CORE_URL=https://platform-core-service:18445
TELEMETRY_RUNTIME_URL=https://telemetry-runtime-service:8446
TELEMETRY_QUERY_URL=https://telemetry-query-service:18447
ALARM_SERVICE_URL=https://alarm-service:8448
COMMAND_SERVICE_URL=https://command-service:8447
WORK_ORDER_SERVICE_URL=https://work-order-service:8449

MQTT_BROKER_URL=mqtts://mqtt-broker:8883
MQTT_TOPIC_ROOT=hvac/production
TELEMETRY_REALTIME_ENABLED=true
TELEMETRY_REALTIME_ENDPOINT=wss://app.energy.example.com/connection/websocket

POSTGRES_ADMIN_PASSWORD=[REDACTED_SECRET]
GATEWAY_DATABASE_URL=[REDACTED_SECRET]
SESSION_TOKEN_KEY=[REDACTED_SECRET]
GRAFANA_ADMIN_PASSWORD=[REDACTED_SECRET]
CENTRIFUGO_HTTP_API_KEY=[REDACTED_SECRET]
CENTRIFUGO_CLIENT_TOKEN_HMAC_SECRET_KEY=[REDACTED_SECRET]
CENTRIFUGO_CLIENT_ALLOWED_ORIGINS=https://app.energy.example.com
CENTRIFUGO_VAR_S2_PROXY_SECRET=[REDACTED_SECRET]
