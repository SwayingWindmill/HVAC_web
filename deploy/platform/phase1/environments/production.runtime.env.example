HVAC_ENV=production
PHASE1_ENV_FILE=./environments/production.runtime.env

HVAC_WEB_IMAGE=registry.example.com/hvac/hvac-web-real@sha256:[SIGNED_DIGEST]
ENERGY_API_IMAGE=registry.example.com/hvac/energy-api@sha256:[SIGNED_DIGEST]
SCHEDULER_IMAGE=registry.example.com/hvac/scheduler@sha256:[SIGNED_DIGEST]
TELEMETRY_WORKER_IMAGE=registry.example.com/hvac/telemetry-worker@sha256:[SIGNED_DIGEST]
METRIC_WORKER_IMAGE=registry.example.com/hvac/metric-worker@sha256:[SIGNED_DIGEST]
IOT_SERVICE_IMAGE=registry.example.com/hvac/iot-service@sha256:[SIGNED_DIGEST]
PHASE1_MIGRATOR_IMAGE=registry.example.com/hvac/phase1-migrator@sha256:[SIGNED_DIGEST]
IAM_SERVICE_IMAGE=registry.example.com/hvac/iam-service@sha256:[SIGNED_DIGEST]
AUDIT_SERVICE_IMAGE=registry.example.com/hvac/audit-ledger-service@sha256:[SIGNED_DIGEST]
CORE_SERVICE_IMAGE=registry.example.com/hvac/platform-core-service@sha256:[SIGNED_DIGEST]
TELEMETRY_QUERY_SERVICE_IMAGE=registry.example.com/hvac/telemetry-query-service@sha256:[SIGNED_DIGEST]
COMMAND_SERVICE_IMAGE=registry.example.com/hvac/command-service@sha256:[SIGNED_DIGEST]
ALARM_SERVICE_IMAGE=registry.example.com/hvac/alarm-service@sha256:[SIGNED_DIGEST]
WORK_ORDER_SERVICE_IMAGE=registry.example.com/hvac/work-order-service@sha256:[SIGNED_DIGEST]
PHASE1_OWNER_SPLIT_RELEASE_MANIFEST=deploy/platform/phase1/runtime/owner-split-release.v1.json
PHASE1_OWNER_SPLIT_RELEASE_MANIFEST_SHA256=[APPROVED_SHA256]

POSTGRES_DATA_DIR=/data/smart-energy/postgres
CLICKHOUSE_DATA_DIR=/data/smart-energy/clickhouse
REDIS_DATA_DIR=/data/smart-energy/redis
MQTT_DATA_DIR=/data/smart-energy/mqtt
# SE-OPS-009: /mnt/smart-energy-backup must be backed by protected off-server storage; a same-server/data-disk directory is not disaster recovery.
POSTGRES_ARCHIVE_MODE=on
POSTGRES_WAL_ARCHIVE_DIR=/mnt/smart-energy-backup/postgres/wal
POSTGRES_BASE_BACKUP_DIR=/mnt/smart-energy-backup/postgres/base
CLICKHOUSE_BACKUP_DIR=/mnt/smart-energy-backup/clickhouse

PUBLIC_ORIGIN=https://app.energy.example.com
HVAC_WEB_BUILD_ID=[GIT_COMMIT]
HVAC_WEB_GATEWAY_BASE_PATH=/api/v1
HVAC_WEB_REALTIME_PROTOCOL=centrifugo-v1
ALLOW_PRODUCTION_EGRESS=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
PHASE1_DEPLOYMENT_TIER=single-lite
PHASE1_OBSERVABILITY_PROFILE=observability-logs
# Stage 2 external PostgreSQL: set MODE=external, HOST/PORT to the external endpoint,
# SSLMODE=require (or stricter), and point every PostgreSQL DSN/URL below at that endpoint.
PHASE1_POSTGRES_MODE=local
PHASE1_POSTGRES_HOST=postgres
PHASE1_POSTGRES_PORT=5432
PHASE1_POSTGRES_SSLMODE=disable
# Stage 2 external ClickHouse: set MODE=external and use the protected HTTP(S) endpoint below.
# Service-specific ClickHouse users/passwords remain deployment secrets.
PHASE1_CLICKHOUSE_MODE=local
PHASE1_CLICKHOUSE_HTTP_URL=http://clickhouse:8123
# Stage 2 external Redis: set MODE=external and point the Redis consumers below at the external endpoint.
# Keep logical DB/prefix separation; Redis HA is a later availability decision.
PHASE1_REDIS_MODE=local
REALTIME_UPSTREAM_URL=http://centrifugo:8000
CENTRIFUGO_ENGINE_REDIS_ADDRESS=redis://redis:6379/0

OIDC_ISSUER=https://app.energy.example.com/identity
OIDC_CLIENT_ID=hvac-web-production
OIDC_REDIRECT_URI=https://app.energy.example.com/api/v1/auth/callback
OIDC_BACKCHANNEL_BASE_URL=http://identity-service:19095
OIDC_STATE_REDIS_URL=redis://redis:6379/1
LIMIT_POLICY_REDIS_URL=redis://redis:6379/2
OIDC_STATE_TTL=10m
SESSION_ABSOLUTE_TTL=8h
SESSION_IDLE_TTL=60m
IDENTITY_ISSUER=https://app.energy.example.com/identity
IDENTITY_CLIENT_ID=hvac-web-production
IDENTITY_REDIRECT_URI=https://app.energy.example.com/api/v1/auth/callback
IDENTITY_POST_LOGOUT_REDIRECT_URI=https://app.energy.example.com/?logged_out=1
IDENTITY_DATABASE_URL=[REDACTED_SECRET]
IDENTITY_ADMIN_DATABASE_URL=[REDACTED_SECRET]
IDENTITY_DIRECTORY_DATABASE_URL=[REDACTED_SECRET]
IAM_RECONCILER_DATABASE_URL=[REDACTED_SECRET]
IDENTITY_SIGNING_KEY_FILE=/run/hvac/identity/signing-key.pem
CORE_URL=https://platform-core-service:18445
TELEMETRY_RUNTIME_URL=https://telemetry-runtime-service:8446
TELEMETRY_QUERY_URL=https://telemetry-query-service:18447
ALARM_SERVICE_URL=https://alarm-service:8448
NOTIFICATION_SERVICE_URL=https://notification-service:8450
COMMAND_SERVICE_URL=https://command-service:8447
WORK_ORDER_SERVICE_URL=https://work-order-service:8449

MQTT_BROKER_URL=mqtts://mqtt-broker:8883
MQTT_TOPIC_ROOT=hvac/production
TELEMETRY_REALTIME_ENABLED=true
TELEMETRY_LATEST_CACHE_ENABLED=true
TELEMETRY_LATEST_CACHE_REDIS_URL=redis://redis:6379/0
TELEMETRY_LIMIT_POLICY_REDIS_URL=redis://redis:6379/2
# TELEMETRY_REALTIME_RELAY_WORKER_ID is optional; replicas default to telemetry-realtime:<hostname>.
TELEMETRY_REALTIME_RELAY_LEASE_DURATION=30s
TELEMETRY_REALTIME_ENDPOINT=wss://app.energy.example.com/realtime/websocket
TELEMETRY_HISTORY_DATABASE_URL=[REDACTED_SECRET]
TELEMETRY_CLICKHOUSE_HTTP_URL=http://clickhouse:8123
TELEMETRY_CLICKHOUSE_DATABASE=telemetry_history

SCHEDULER_POSTGRES_DSN=[REDACTED_SECRET]
MAINTENANCE_POSTGRES_DSN=[REDACTED_SECRET]
FORECAST_POSTGRES_DSN=[REDACTED_SECRET]
OPTIMIZATION_POSTGRES_DSN=[REDACTED_SECRET]
FDD_DATABASE_URL=[REDACTED_SECRET]
SCHEDULER_SCAN_INTERVAL=2s
SCHEDULER_SCAN_BATCH=100

METRIC_POSTGRES_DSN=[REDACTED_SECRET]
METRIC_CLICKHOUSE_URL=http://clickhouse:8123
METRIC_REDIS_URL=redis://redis:6379/0
# METRIC_WORKER_ID is optional; replicas default to metric-worker:<hostname>.
METRIC_JOB_CLAIM_INTERVAL=2s
METRIC_JOB_CLAIM_BATCH=20
METRIC_JOB_LEASE_DURATION=60s
METRIC_JOB_LEASE_RENEW_INTERVAL=20s
METRIC_WORKER_FINALIZATION_DELAY=5m

AUDIT_OUTBOX_DATABASE_URL=[REDACTED_SECRET]

OBJECT_STORAGE_PROVIDER=[S3_COMPATIBLE|AWS_S3|AZURE_BLOB|GCS]
OBJECT_STORAGE_ENDPOINT_REFERENCE=[CONFIG_OR_SECRET_REFERENCE]
OBJECT_STORAGE_CREDENTIAL_REFERENCE=[SECRET_REFERENCE]
OBJECT_STORAGE_BUCKET_CATALOG_REFERENCE=[CONFIG_REFERENCE]

MQTT_TELEMETRY_ADAPTER_CONFIG=[RUNTIME_CONFIG_FILE]
CONNECTIVITY_DATABASE_URL=postgres://connectivity_runtime:[REDACTED_SECRET]@postgres:5432/hvac_s1?sslmode=require
CONNECTIVITY_TENANT_ID=[UUIDV7]
COMMAND_RUNTIME_URL=https://command-service:8447
COMMAND_RUNTIME_SERVER_NAME=command-service
COMMAND_RUNTIME_CLIENT_CERT=[RUNTIME_SECRET_FILE]
COMMAND_RUNTIME_CLIENT_KEY=[RUNTIME_SECRET_FILE]
COMMAND_RUNTIME_SERVER_CA=[RUNTIME_TRUST_FILE]
S2_DISPATCH_SAFETY_URL=https://telemetry-runtime-service:8446
S2_DISPATCH_SAFETY_SERVER_NAME=telemetry-runtime-service
S2_DISPATCH_SAFETY_SERVER_CA=[RUNTIME_TRUST_FILE]
MQTT_COMMAND_CA=[RUNTIME_TRUST_FILE]
MQTT_COMMAND_CERT=[RUNTIME_SECRET_FILE]
MQTT_COMMAND_KEY=[RUNTIME_SECRET_FILE]
MQTT_COMMAND_SERVER_NAME=mqtt-broker
COMMAND_VERIFICATION_REPORTED_STATE_KEY=[RUNTIME_CONFIG]
S2_REPORTED_STATE_URL=https://telemetry-runtime-service:8446
S2_REPORTED_STATE_SERVER_NAME=telemetry-runtime-service
S2_REPORTED_STATE_CLIENT_CERT=[RUNTIME_SECRET_FILE]
S2_REPORTED_STATE_CLIENT_KEY=[RUNTIME_SECRET_FILE]
S2_REPORTED_STATE_SERVER_CA=[RUNTIME_TRUST_FILE]

POSTGRES_ADMIN_PASSWORD=[REDACTED_SECRET]
GATEWAY_DATABASE_URL=[REDACTED_SECRET]
RULE_RUNTIME_DATABASE_URL=[REDACTED_SECRET]
SESSION_TOKEN_KEY=[REDACTED_SECRET]
GRAFANA_ADMIN_PASSWORD=[REDACTED_SECRET]
CENTRIFUGO_HTTP_API_KEY=[REDACTED_SECRET]
CENTRIFUGO_CLIENT_TOKEN_HMAC_SECRET_KEY=[REDACTED_SECRET]
CENTRIFUGO_CLIENT_ALLOWED_ORIGINS=https://app.energy.example.com
CENTRIFUGO_VAR_S2_PROXY_SECRET=[REDACTED_SECRET]
