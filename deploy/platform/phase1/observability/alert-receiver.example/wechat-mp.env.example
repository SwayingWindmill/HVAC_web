# 微信公众号 / 测试号模板消息告警接收配置（复制为 ${PHASE1_RUNTIME_DIR}/alert-receiver/wechat-mp.env，权限 0640 属组 65532）
# 可用已认证服务号，或微信官方免费公众平台测试号（https://mp.weixin.qq.com/debug/cgi-bin/sandbox?t=sandbox/login）
WECHAT_MP_APP_ID=REPLACE_WITH_APP_ID
WECHAT_MP_TEMPLATE_ID=REPLACE_WITH_TEMPLATE_ID
# 多个接收人 OpenID 用英文逗号分隔
WECHAT_MP_OPENIDS=REPLACE_WITH_OPENID_1
# 可选：点击模板卡片跳转的平台地址（必须为 https:// 开头）
WECHAT_MP_URL=https://hvac.qlhtech.com/overview
# 可选：模板字段名覆盖（默认 title / severity / summary / time；填 - 可省略对应字段）
# WECHAT_MP_KEY_TITLE=title
# WECHAT_MP_KEY_SEVERITY=severity
# WECHAT_MP_KEY_SUMMARY=summary
# WECHAT_MP_KEY_TIME=time
