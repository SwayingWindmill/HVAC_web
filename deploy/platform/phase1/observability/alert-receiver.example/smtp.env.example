# Copy this directory's files (without the .example suffix) to the host runtime directory
# ${PHASE1_RUNTIME_DIR}/alert-receiver/ and replace the placeholders. Those copies are gitignored
# because the whole runtime directory is. 465 is implicit TLS: set SMTP_REQUIRE_TLS=false.
SMTP_SMARTHOST=smtp.example.com:465
SMTP_FROM=alerts@example.com
SMTP_AUTH_USERNAME=alerts@example.com
SMTP_TO=ops@example.com
SMTP_REQUIRE_TLS=false
