{
  "log": { "level": "info" },
  "http_server": { "address": "0.0.0.0", "port": "8000" },
  "http_api": { "key": "[REDACTED_SECRET]" },
  "client": {
    "allowed_origins": ["[DEPLOYMENT_HVAC_WEB_ORIGIN]"],
    "token": { "hmac_secret_key": "[REDACTED_SECRET]" },
    "queue_max_size": 262144,
    "channel_limit": 100,
    "history_max_publication_limit": 256,
    "recovery_max_publication_limit": 256
  },
  "engine": {
    "type": "redis",
    "redis": {
      "address": "redis://redis:6379/0",
      "prefix": "hvac_phase1_realtime"
    }
  },
  "health": { "enabled": true },
  "prometheus": { "enabled": true, "native_histograms": true },
  "proxies": [
    {
      "name": "telemetry-subscribe",
      "endpoint": "https://telemetry-runtime-service:8446/internal/v1/telemetry/centrifugo/subscribe",
      "timeout": "300ms",
      "http": {
        "tls": {
          "enabled": true,
          "cert_pem": "/run/hvac/pki/centrifugo/tls.crt",
          "key_pem": "/run/hvac/pki/centrifugo/tls.key",
          "server_ca_pem": "/run/hvac/pki/telemetry/ca.crt",
          "insecure_skip_verify": false,
          "server_name": "telemetry-runtime-service"
        },
        "static_headers": [
          { "key": "X-Centrifugo-Proxy-Secret", "value": "${CENTRIFUGO_VAR_S2_PROXY_SECRET}" }
        ]
      }
    }
  ],
  "channel": {
    "namespaces": [
      {
        "name": "s2",
        "subscribe_proxy_enabled": true,
        "subscribe_proxy_name": "telemetry-subscribe",
        "history_size": 256,
        "history_ttl": "180s",
        "force_recovery": true,
        "force_positioning": true
      }
    ]
  }
}
