  "securityZeroInvariants": [
    "cross_organization_successes",
    "cross_site_successes",
    "hidden_device_disclosures",
    "forged_scope_successes",
    "unauthorized_key_disclosures",
    "post_revocation_publications",
    "cursor_scope_expansions",
    "cursor_replay_authorization_bypasses",
    "raw_token_log_findings",
    "raw_cursor_log_findings",
    "raw_channel_log_findings",
    "telemetry_value_log_findings",
    "legacy_or_mock_fallbacks",
    "non_owner_s2_business_writes",
    "undetected_revision_gaps"
  ],
  "negativeTests": [
    {
      "id": "cross-organization-single-read",
      "surface": "single-snapshot",
      "expectedStatus": 404,
      "expectedCode": "RESOURCE_NOT_FOUND",
      "invariant": "no-resource-disclosure"
    },
    {
      "id": "cross-site-batch-read",
      "surface": "batch-snapshot",
      "expectedStatus": 200,
      "expectedItemCode": "RESOURCE_NOT_FOUND",
      "invariant": "ordered-item-nondiscoverability"
    },
    {
      "id": "forged-browser-identity-headers",
      "surface": "all-http",
      "expectedStatus": 400,
      "expectedCode": "TELEMETRY_REQUEST_INVALID",
      "invariant": "no-scope-expansion"
    },
    {
      "id": "hidden-device-subscription",
      "surface": "subscription-bootstrap",
      "expectedStatus": 404,
      "expectedCode": "RESOURCE_NOT_FOUND",
      "invariant": "no-partial-capability"
    },
    {
      "id": "forged-channel-subscription",
      "surface": "subscribe-proxy",
      "expectedDecision": "deny",
      "invariant": "channel-is-not-authority"
    },
    {
      "id": "revocation-stops-delivery",
      "surface": "live-subscription",
      "expectedMaximumMilliseconds": 10000,
      "invariant": "zero-post-revocation-publications"
    },
    {
      "id": "cursor-cross-principal-replay",
      "surface": "subscription-bootstrap",
      "expectedStatus": 400,
      "expectedCode": "RECOVERY_CURSOR_INVALID",
      "invariant": "cursor-has-no-authority"
    },
    {
      "id": "cursor-cross-device-or-key-replay",
      "surface": "subscription-bootstrap",
      "expectedStatus": 400,
      "expectedCode": "RECOVERY_CURSOR_INVALID",
      "invariant": "cursor-scope-bound"
    },
    {
      "id": "key-enumeration-visible-device",
      "surface": "single-and-batch-snapshot",
      "expectedStatus": 400,
      "expectedCode": "TELEMETRY_KEY_INVALID",
      "invariant": "unknown-and-unauthorized-keys-indistinguishable"
    },
    {
      "id": "key-enumeration-hidden-device",
      "surface": "single-and-batch-snapshot",
      "expectedStatus": 404,
      "expectedCode": "RESOURCE_NOT_FOUND",
      "invariant": "device-invisibility-precedes-key-validation"
    }
  ],
