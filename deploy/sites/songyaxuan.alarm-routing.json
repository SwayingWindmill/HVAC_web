{
  "schemaVersion": 1,
  "siteId": "01a14000-1000-7000-8000-000000000001",
  "siteName": "松雅轩",
  "timezone": "Asia/Shanghai",
  "holdMinutes": 3,
  "maxAgeHours": 12,
  "rateLimitPerHour": 6,
  "quietHours": { "start": "22:00", "end": "07:00", "bypassSeverity": "MAJOR" },
  "rootCauseAlarmType": "reports-interrupted",
  "suppressWhenRootCause": ["reading-gap/", "readings-not-updated/", "readings-flat/", "data-quality/", "rules-unevaluable"],
  "rootCauseRules": [
    {
      "whenActivePrefix": "reports-interrupted",
      "suppressPrefixes": ["readings-not-updated", "reading-gap/", "rules-unevaluable", "data-quality/"]
    },
    {
      "whenActivePrefix": "device-untrusted/",
      "scopeSameDevice": true,
      "suppressPrefixes": ["data-quality/suspect/", "reading-gap/", "readings-not-updated/"]
    }
  ],
  "routes": [
    {
      "name": "major",
      "minSeverity": "MAJOR",
      "cooldownMinutes": 10,
      "groupWindowSeconds": 60,
      "groupMaxItems": 10,
      "groupBy": "severity",
      "notifyAck": true,
      "notifyRecovery": true,
      "steps": [
        { "afterMinutes": 0, "recipients": ["songyaxuan-duty"], "channels": ["wecom_app", "smtp"] },
        { "afterMinutes": 15, "recipients": ["songyaxuan-lead"], "channels": ["wecom_app", "smtp", "wecom_bot"] }
      ]
    },
    {
      "name": "warning",
      "minSeverity": "WARNING",
      "cooldownMinutes": 30,
      "groupWindowSeconds": 60,
      "groupMaxItems": 10,
      "groupBy": "severity",
      "notifyAck": false,
      "notifyRecovery": false,
      "steps": [
        { "afterMinutes": 0, "recipients": ["songyaxuan-duty"], "channels": ["smtp"] }
      ]
    }
  ]
}
