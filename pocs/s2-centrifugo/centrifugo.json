{
  "log": {
    "level": "info"
  },
  "client": {
    "allowed_origins": [
      "http://localhost:5173"
    ],
    "queue_max_size": 262144,
    "channel_limit": 100,
    "history_max_publication_limit": 256,
    "recovery_max_publication_limit": 256
  },
  "engine": {
    "type": "redis",
    "redis": {
      "address": "redis://redis:6379/0"
    }
  },
  "health": {
    "enabled": true
  },
  "prometheus": {
    "enabled": true,
    "native_histograms": true,
    "recovered_publications_histogram": true
  },
  "proxies": [
    {
      "name": "s2-subscribe",
      "endpoint": "http://owner:18081/centrifugo/subscribe",
      "timeout": "2s"
    }
  ],
  "channel": {
    "namespaces": [
      {
        "name": "s2",
        "subscribe_proxy_enabled": true,
        "subscribe_proxy_name": "s2-subscribe",
        "history_size": 256,
        "history_ttl": "180s",
        "force_recovery": true,
        "force_positioning": true
      }
    ]
  }
}
